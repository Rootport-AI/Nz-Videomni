# Environment isolation — never commit the local interpreter / venv
.venv/
.python/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Runtime data
outputs/*
!outputs/.gitkeep
uploads/*
!uploads/.gitkeep
logs/*
!logs/.gitkeep
models/*
!models/.gitkeep

# ---------------------------------------------------------------------------
# Heavy LTX data — MUST NEVER reach the GitHub repo.
# These are installed locally by scripts/install_ltx.ps1.
# ---------------------------------------------------------------------------

# Cloned official LTX-2 repository (+ its own .venv) and any vendored code
vendor/
LTX-2/

# Model weights / large binary artifacts (safety net regardless of location)
*.safetensors
*.ckpt
*.pt
*.pth
*.bin
*.gguf
*.onnx
*.npz
*.tar
*.zip

# HuggingFace / torch caches if redirected into the project
.hf_cache/
.cache/
hf_home/

# uv lockfile (resolved per-machine here)
uv.lock
