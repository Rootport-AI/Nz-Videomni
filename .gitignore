# Environment isolation — never commit the local interpreter / venv
.venv/
.venv-engine/
.python/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Runtime data
outputs/*
!outputs/.gitkeep
uploads/*
!uploads/.gitkeep
logs/*
!logs/.gitkeep
# 過去のデバッグ生ログ。旧パスの写り込みがあり、追跡する価値がない。
logs_diag/
models/*
!models/.gitkeep

# ---------------------------------------------------------------------------
# Heavy LTX data — MUST NEVER reach the GitHub repo.
# These are installed locally by scripts/install_ltx.ps1.
# ---------------------------------------------------------------------------

# The engine is now first-party (project-root ./engine, git-tracked); the
# low-VRAM fork tree was removed in Stage 2b, so no vendor negation is needed.
# Everything under vendor/ stays ignored. The official LTX-2 clone
# (vendor/LTX-2) is a re-cloneable upstream reference kept out of the repo.
# Engine provenance: engine/VENDOR_NOTICE.md.
vendor/*
LTX-2/

# Model weights / large binary artifacts (safety net regardless of location)
*.safetensors
*.ckpt
*.pt
*.pth
*.bin
*.gguf
*.onnx
*.npz
*.tar
*.zip
# Exception: the AviUtl2 plugin package (~378 KB) ships inside this repo so the
# installer flow is self-contained. Plain git object, NOT Git LFS on purpose --
# LFS would force every user to install git-lfs before cloning.
!*.au2pkg.zip

# HuggingFace / uv / torch caches redirected into the project (install_ltx.ps1)
.hf_cache/
.cache/
hf_home/
.uv_cache/

# uv lockfile (resolved per-machine here)
uv.lock

# ---------------------------------------------------------------------------
# Local setup artifacts — created by setup.bat, never committed
# ---------------------------------------------------------------------------

# User-edited configuration. Tracking it would make every `git pull` stop on a
# merge conflict against the settings the user tuned for their own machine.
# The template that ships with the repo is config.yaml.example; setup.bat and
# run.bat copy it into place when config.yaml is missing.
config.yaml

# Prerequisite tools fetched by setup.bat (uv + ffmpeg/ffprobe), ~378 MB on disk.
# Leading slash: root-only, so this must never shadow mcp_server/tools/ (the
# MCP server's own source package) or any other nested tools/ directory.
/tools/

# Generated by setup.ps1 with ABSOLUTE, machine-specific paths (this machine's
# .venv\Scripts\python.exe). Committing it would break every other machine's
# MCP registration and leak local filesystem layout. See scripts/setup.ps1 /
# README "AIエージェント連携（MCPサーバー）".
.mcp.json
