# Environment isolation — never commit the local interpreter / venv
.venv/
.venv-engine/
.python/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Runtime data
outputs/*
!outputs/.gitkeep
uploads/*
!uploads/.gitkeep
logs/*
!logs/.gitkeep
models/*
!models/.gitkeep

# ---------------------------------------------------------------------------
# Heavy LTX data — MUST NEVER reach the GitHub repo.
# These are installed locally by scripts/install_ltx.ps1.
# ---------------------------------------------------------------------------

# Vendored code is ignored EXCEPT the patched low-VRAM fork's backend SOURCE,
# so our engine patches (Approach W worker, GGUF Gemma, block-swap, component-
# files, the per-job leak fix, etc.) are version-controlled. Heavy/generated
# content inside it is still excluded by the global rules above (.venv/,
# __pycache__/, *.py[cod], *.safetensors, *.gguf, uv.lock, ...). The official
# LTX-2 clone (vendor/LTX-2) stays ignored = re-cloneable upstream reference.
# Provenance + patch list: vendor/LTX-Desktop-LOW-VRAM/backend/VENDOR_NOTICE.md.
vendor/*
!vendor/LTX-Desktop-LOW-VRAM/
vendor/LTX-Desktop-LOW-VRAM/*
!vendor/LTX-Desktop-LOW-VRAM/backend/
LTX-2/

# Model weights / large binary artifacts (safety net regardless of location)
*.safetensors
*.ckpt
*.pt
*.pth
*.bin
*.gguf
*.onnx
*.npz
*.tar
*.zip

# HuggingFace / uv / torch caches redirected into the project (install_ltx.ps1)
.hf_cache/
.cache/
hf_home/
.uv_cache/

# uv lockfile (resolved per-machine here)
uv.lock
