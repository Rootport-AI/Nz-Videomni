{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 20, "patch": 0 },
  "configurePresets": [
    {
      "name": "ninja-release",
      "displayName": "Ninja x64 Release (MSVC via vcvars)",
      "description": "Primary preset. Requires cl.exe on PATH (scripts/build.ps1 sources vcvars64.bat from Visual Studio 18).",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ninja-release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "ninja-debug",
      "displayName": "Ninja x64 Debug (MSVC via vcvars)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ninja-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "vs2022",
      "displayName": "Visual Studio 17 2022 x64 (requires a matching VS install)",
      "description": "Multi-config VS generator. Only usable if a Visual Studio 2022 instance is present. On a VS 18 / 2026 host, use the ninja-* presets instead until a CMake that knows the VS 18 generator is available.",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/vs2022"
    }
  ],
  "buildPresets": [
    { "name": "ninja-release", "configurePreset": "ninja-release" },
    { "name": "ninja-debug", "configurePreset": "ninja-debug" },
    { "name": "vs2022-release", "configurePreset": "vs2022", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "ninja-release", "configurePreset": "ninja-release", "output": { "outputOnFailure": true } },
    { "name": "ninja-debug", "configurePreset": "ninja-debug", "output": { "outputOnFailure": true } },
    { "name": "vs2022-release", "configurePreset": "vs2022", "configuration": "Release", "output": { "outputOnFailure": true } }
  ]
}
