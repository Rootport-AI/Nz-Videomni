+# === MiniMax H3 chain (2026-11-08, 台帳 §1-276, plan cozy-gliding-pudding §4.1) ===
+# A chain point is ``{kind: "chain", clips: [{num_frames, references?}], keyframes
+# (clip 0's), source_video? ({source_path}), predict: {clips: [...]}}``.  Every
+# chain path is a SEPARATE function chosen by ``is_h3_chain(point)`` in the
+# shared dispatchers (token_counts / build_request / check_point / analyse /
+# cmd_run / report), BEFORE their ``is_h3`` branch, so the H3 Single functions
+# above (token_counts_h3 / build_request_h3 / check_point_h3 / analyse_h3 /
+# used_check_h3 / h3_report_cells) are unchanged byte for byte and are reused
+# here per clip where the rule is the same.
+H3_CHAIN_ENDPOINT = "/generate/chain"
+# Keys a chain clip may carry (key frames are the point's ``keyframes`` block =
+# clip 0's; a clip has no prompt of its own: text = the shared prompt, plan §4.1).
+H3_CHAIN_CLIP_KEYS = ("num_frames", "references")
+H3_CHAIN_SOURCE_KEYS = ("source_path",)
+# Keys a chain point must not carry: the LTX chain's, the Single shot's
+# ``num_frames`` / point-level ``references`` (a chain's are per clip), and the
+# keys this campaign leaves at the user's default by NOT sending them.
+H3_CHAIN_FORBIDDEN_POINT_KEYS = ("num_frames", "references", "stage2_window", "chunked_upsample",
+                                 "source_audio", "audio_id", "outpaint", "reference",
+                                 "reference_downscale_factor", "keep_resident", "vram16_mode",
+                                 "shift_video", "shift_audio", "overlap_frames", "overlap_strength")
+# The point-level keys check_point_h3 does not know (removed before a clip is
+# handed to it as a Single point).
+H3_CHAIN_ONLY_KEYS = ("clips", "source_video", "predict")
+# worker log (engine_h3/chain_h3.py:248): "chain: clip {i + 1}/{n} ..." -- 1-BASED.
+H3_CHAIN_CLIP_RE = re.compile(r"chain: clip (?P<i>\d+)/(?P<n>\d+)")
+DRY_RUN_SOURCE_ID = "<video_id: POST /upload/video of %s sha256=%s>"
+
+
+def is_h3_chain(point: dict) -> bool:
+    return is_h3(point) and point.get("kind") == "chain"
+
+
+def h3_chain_layout(clip_frames, source_video: bool):
+    """The product's own chain geometry (h3_chain_math.compute_h3_chain_layout at
+    the repository root: torch-free, so the app venv imports it).  Called, never
+    copied (plan §4.1 S2).  Raises ValueError with the product's 422 message."""
+    if str(ROOT) not in sys.path:
+        sys.path.append(str(ROOT))
+    import h3_chain_math  # noqa: PLC0415
+    return h3_chain_math.compute_h3_chain_layout(list(clip_frames), source_video=bool(source_video))
+
+
+def h3_chain_clip_point(point: dict, i: int) -> dict:
+    """Clip ``i`` as the H3 SINGLE point ``token_counts_h3`` / ``check_point_h3``
+    read: the shared fields, the clip's num_frames and references, and the key
+    frames on clip 0 only (none on a V2V clip 0).  The clip's S is the Single
+    formula with F = the clip's length (plan §1: the fixed head adds no row)."""
+    clip = (point.get("clips") or [])[i]
+    p = {k: v for k, v in point.items() if k not in H3_CHAIN_ONLY_KEYS and k != "keyframes"}
+    p["kind"] = "single"
+    p["num_frames"] = int(clip.get("num_frames") or 0)
+    p["references"] = list(clip.get("references") or [])
+    if i == 0 and point.get("keyframes") and not point.get("source_video"):
+        p["keyframes"] = point["keyframes"]
+    return p
+
+
+def token_counts_h3_chain(point: dict) -> dict:
+    """Per-clip H3 token counts: clip i = token_counts_h3 of h3_chain_clip_point
+    (cond only on clip 0's key frames; clips >= 1 and a V2V clip 0 have none;
+    text = the shared prompt + clip 0's key-frame vision tokens / that clip's
+    references).  ``predict.clips[i]`` = {video, cond, ref_video, ref_audio,
+    audio, text, total} -- what the plan file carries and preflight re-derives."""
+    clips = point.get("clips") or []
+    per = [token_counts_h3(h3_chain_clip_point(point, i)) for i in range(len(clips))]
+    layout, layout_error = None, None
+    try:
+        layout = h3_chain_layout([int(c.get("num_frames") or 0) for c in clips],
+                                 bool(point.get("source_video"))).to_dict()
+    except (ValueError, AssertionError) as exc:
+        layout_error = str(exc)
+    pred = []
+    for c in per:
+        p = c["predict"]
+        pred.append({"video": p["video"], "cond": p["cond"], "ref_video": p["ref_video"],
+                     "ref_audio": p["ref_audio"], "audio": p["audio"], "text": p["text_estimate"],
+                     "total": p["S_estimate"]})
+    vcs = [c["video_plus_cond"] for c in per] or [0]
+    return {
+        "engine": "h3", "kind": "chain", "n_clips": len(clips),
+        "clip_frames": [int(c.get("num_frames") or 0) for c in clips],
+        "width_tokens": per[0]["width_tokens"] if per else None,
+        "height_tokens": per[0]["height_tokens"] if per else None,
+        "grid": per[0]["grid"] if per else None,
+        "keyframes": per[0]["keyframes"] if per else 0,
+        "source_video": bool(point.get("source_video")),
+        "clips": per,
+        "layout": layout, "layout_error": layout_error,
+        "total_pixel_frames": (layout or {}).get("total_px"),
+        # the shared printing code reads one key per engine: the LARGEST clip
+        "video_plus_cond": max(vcs), "stage2_tokens": max(vcs),
+        "decode_chunks_expected": None,
+        "prompt_tokens": per[0]["prompt_tokens"] if per else None,
+        "predict": {"clips": pred},
+    }
+
+
+def check_point_h3_chain(point: dict, labels: set) -> dict:
+    """All offline checks for one H3 chain point (plan §4.1 S2).
+    * the rules a chain shares with a single shot (geometry multiples, steps,
+      accel, key frames on clip 0, references and their transformer, LoRA,
+      baseline, prompt, the user-default warnings): check_point_h3 on each clip
+      as a Single point (h3_chain_clip_point) -- reused, not copied; an error
+      every clip shares is reported once;
+    * the chain's own length / clip count / total rules: the PRODUCT's
+      h3_chain_math.compute_h3_chain_layout, called directly (clips[i] >= 1 at
+      least 39 frames, 2..24 clips -- 1..24 with a source video --, 11,544 in all);
+    * refused here: any image on a clip (key frames are the point's
+      ``keyframes`` = clip 0's), ``stage2_window`` / ``chunked_upsample`` /
+      ``source_audio`` and the other keys of H3_CHAIN_FORBIDDEN_POINT_KEYS, a
+      source video with key frames, a source video shorter than 22 frames.
+    * the plan file's ``predict`` must equal token_counts_h3_chain's."""
+    label = point.get("label")
+    width, height = int(point.get("width") or 0), int(point.get("height") or 0)
+    errors, warnings = [], []
+    clips = point.get("clips")
+    if not isinstance(clips, list) or not clips:
+        errors.append("clips must be a non-empty list")
+        clips = []
+    for key in H3_CHAIN_FORBIDDEN_POINT_KEYS:
+        if key in point:
+            errors.append("an H3 chain point must not carry %r" % key)
+    for i, clip in enumerate(clips):
+        if not isinstance(clip, dict):
+            errors.append("clips[%d] is not an object" % i)
+            continue
+        extra = sorted(k for k in clip if k not in H3_CHAIN_CLIP_KEYS)
+        if extra:
+            errors.append("clips[%d] carries %s; a chain clip takes only %s (key frames are the "
+                          "point's keyframes block = clip 0's; no clip prompt)"
+                          % (i, extra, list(H3_CHAIN_CLIP_KEYS)))
+        if not isinstance(clip.get("num_frames"), int) or isinstance(clip.get("num_frames"), bool):
+            errors.append("clips[%d].num_frames %r is not an integer" % (i, clip.get("num_frames")))
+    source = point.get("source_video")
+    if source is not None:
+        if not isinstance(source, dict):
+            errors.append("source_video must be an object {source_path}")
+            source = {}
+        extra = sorted(k for k in source if k not in H3_CHAIN_SOURCE_KEYS)
+        if extra:
+            errors.append("source_video carries %s (only source_path; context_frames is left out = 22)"
+                          % extra)
+        spath = ref_source_path(source)
+        if not source.get("source_path") or not spath.exists():
+            errors.append("source_video.source_path %r does not exist" % source.get("source_path"))
+        else:
+            info = probe_media(spath)
+            if info.get("frames_24") is None or info["frames_24"] < 22:
+                errors.append("source_video has %s frames at 24 fps (< the 22 context frames)"
+                              % info.get("frames_24"))
+        if (point.get("keyframes") or {}).get("frame_idx"):
+            errors.append("source_video and keyframes given together (the engine refuses V2V "
+                          "with clip 0 key frames)")
+    good_frames = [c.get("num_frames") for c in clips if isinstance(c, dict)]
+    layout = None
+    if len(good_frames) == len(clips) and all(isinstance(f, int) and not isinstance(f, bool)
+                                              for f in good_frames):
+        try:
+            layout = h3_chain_layout(good_frames, source is not None)
+        except (ValueError, AssertionError) as exc:
+            errors.append("chain layout (h3_chain_math): %s" % exc)
+
+    # the Single rules, clip by clip; an error every clip shares is said once
+    per_clip = {}
+    clip_rows = []
+    for i, clip in enumerate(clips):
+        if not isinstance(clip, dict) or not isinstance(clip.get("num_frames"), int):
+            continue
+        row = check_point_h3(h3_chain_clip_point(point, i), labels)
+        clip_rows.append(row)
+        for msg in row["errors"]:
+            per_clip.setdefault(msg, []).append(i)
+        if i == 0:
+            warnings.extend(row["warnings"])
+    for msg, where in per_clip.items():
+        errors.append("clips%s: %s" % (where, msg))
+
+    counts = {}
+    if clips and not any("does not exist" in e for e in errors):
+        try:
+            counts = token_counts_h3_chain(point)
+        except Exception as exc:  # noqa: BLE001
+            errors.append("token counts: %s: %s" % (type(exc).__name__, exc))
+        plan_pred = point.get("predict")
+        if counts and plan_pred is not None and plan_pred != counts.get("predict"):
+            errors.append("the plan file's predict %s != the bench's %s"
+                          % (plan_pred, counts.get("predict")))
+        if counts and plan_pred is None:
+            errors.append("the plan file carries no predict (mkplan.py writes it)")
+    image = keyframe_image_path(point)
+    frame_idx = [int(n) for n in ((point.get("keyframes") or {}).get("frame_idx") or [])]
+    return {
+        "label": label, "kind": "chain", "base_model": point.get("base_model"),
+        "transformer": point.get("transformer"),
+        "geometry": "%dx%d clips=%s%s" % (width, height, good_frames,
+                                         " V2V" if source is not None else ""),
+        "clip_frames": good_frames,
+        "layout": layout.to_dict() if layout is not None else None,
+        "predict": counts.get("predict"),
+        "clip_references": [c.get("references") for c in counts.get("clips") or []],
+        "keyframes": len(frame_idx), "frame_idx": frame_idx,
+        "keyframe_image": str(image) if image else None,
+        "keyframe_image_sha256": sha256_of(image) if (image and image.exists()) else None,
+        "source_video": (source or {}).get("source_path") if source is not None else None,
+        "num_inference_steps": point.get("num_inference_steps"),
+        "loras": point.get("loras") or [],
+        "job_timeout_s": job_timeout_for(point, "auto"),
+        "baseline_label": point.get("baseline_label"), "is_baseline": bool(point.get("is_baseline")),
+        "smoke": bool(point.get("smoke")),
+        "accel": h3_accel(point),
+        "ok": not errors, "errors": errors, "warnings": warnings,
+    }
+
+
+def build_request_h3_chain(point: dict, ids=None, image_id=None):
+    """The H3 /generate/chain body (plan §4.1 S3).  Sent keys: prompt, width,
+    height, frame_rate, seed, attention_backend, block_swap_prefetch,
+    num_inference_steps, loras, clips[{num_frames, conditioning_images (clip 0
+    only, when K > 0), references (only on a clip that has some)}] and, for
+    V2V, source_video {video_id} (context_frames left out = 22, written back
+    by the H3 adapter).  ``attention_backend`` and ``num_inference_steps`` are
+    ALWAYS sent: the chain API's own defaults are sdpa / 8, and an omitted
+    steps falls back to the H3 default 20 (services/engines/h3/adapter.py
+    validate_chain).  NOT sent: keep_resident / vram16_mode (= the user's
+    defaults), the LTX chain keys (overlap / stage2_window / chunked_upsample),
+    a clip prompt (text = the shared prompt).
+
+    ``ids``: ``{"references": {(clip, kind, slot): id}, "source_video": id}``
+    from the uploads, or None (--dry-run placeholders naming the endpoint, the
+    file and its sha256).  ``image_id``: clip 0's key-frame image (None = the
+    placeholder)."""
+    accel = h3_accel(point)
+    ref_ids = (ids or {}).get("references") if isinstance(ids, dict) else None
+    clips = []
+    for i, clip in enumerate(point.get("clips") or []):
+        entry = {"num_frames": int(clip["num_frames"])}
+        frame_idx = (point.get("keyframes") or {}).get("frame_idx") or [] if i == 0 else []
+        if frame_idx:
+            iid = image_id
+            if iid is None:
+                path = keyframe_image_path(point)
+                iid = DRY_RUN_IMAGE_ID % (path.name if path else None,
+                                          sha256_of(path) if path and path.exists() else "MISSING")
+            entry["conditioning_images"] = [{"image_id": iid, "frame_idx": int(n)} for n in frame_idx]
+        refs = []
+        for ref in clip.get("references") or []:
+            kind, slot = ref["kind"], int(ref["slot"])
+            if ref_ids is not None:
+                rid = ref_ids.get((i, kind, slot))
+            else:
+                path = ref_source_path(ref)
+                rid = DRY_RUN_REF_ID % (H3_REF_UPLOAD[kind][1], H3_REF_UPLOAD[kind][0], path.name,
+                                        sha256_of(path) if path.exists() else "MISSING")
+            item = {"kind": kind, "id": rid, "slot": slot}
+            if ref.get("max_sec") is not None:
+                item["max_sec"] = float(ref["max_sec"])
+            refs.append(item)
+        if refs:
+            entry["references"] = refs
+        clips.append(entry)
+    body = {
+        "prompt": point.get("prompt") or "",
+        "width": int(point["width"]), "height": int(point["height"]),
+        "frame_rate": float(point.get("frame_rate", FRAME_RATE)),
+        "seed": int(point.get("seed", DEFAULT_SEED)),
+        "attention_backend": accel["attention_backend"],
+        "block_swap_prefetch": bool(accel["block_swap_prefetch"]),
+        "num_inference_steps": int(point["num_inference_steps"]),
+        "loras": [{"name": spec["name"], "strength": float(spec.get("strength", 1.0))}
+                  for spec in (point.get("loras") or [])],
+        "clips": clips,
+    }
+    source = point.get("source_video")
+    if source:
+        sid = (ids or {}).get("source_video") if isinstance(ids, dict) else None
+        if sid is None:
+            path = ref_source_path(source)
+            sid = DRY_RUN_SOURCE_ID % (path.name, sha256_of(path) if path.exists() else "MISSING")
+        body["source_video"] = {"video_id": sid}
+    return H3_CHAIN_ENDPOINT, body
+
