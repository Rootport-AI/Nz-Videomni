+def resolve_chain_uploads(point: dict, cache: dict, refresh: bool = False):
+    """``(ids, records, source_record)`` for a chain point (plan §4.1 S5):
+    each clip's references through resolve_reference_uploads (one upload per
+    (kind, sha256), reused), keyed ``(clip, kind, slot)``; the V2V source video
+    uploaded once per sha256 through POST /upload/video (key
+    ``source_video|<sha256>`` in reference_uploads.json).  ``refresh`` drops
+    the remembered ids (a submit answered REFERENCE_NOT_FOUND /
+    SOURCE_VIDEO_NOT_FOUND: the uploads store is temporary)."""
+    ref_ids, records = {}, []
+    for i, clip in enumerate(point.get("clips") or []):
+        ids, recs = resolve_reference_uploads({"references": clip.get("references") or []},
+                                              cache, refresh=refresh)
+        for (kind, slot), rid in ids.items():
+            ref_ids[(i, kind, slot)] = rid
+        records += [dict(r, clip=i) for r in recs]
+    source_id, source_rec = None, None
+    source = point.get("source_video")
+    if source:
+        path = ref_source_path(source)
+        if not path.exists():
+            raise FileNotFoundError("source video not found: %s" % path)
+        digest = sha256_of(path)
+        key = "source_video|%s" % digest
+        if not refresh and key in cache and cache[key].get("video_id"):
+            source_rec = dict(cache[key], source="cache")
+        else:
+            say("  uploading source video %s (sha256 %s) -> /upload/video" % (path.name, digest[:16]))
+            code, resp = api_multipart("/upload/video", "file", path)
+            if code >= 400 or not resp or not resp.get("video_id"):
+                raise RuntimeError("source video upload failed %s: %s"
+                                   % (code, json.dumps(resp, ensure_ascii=False)[:400]))
+            stored = {"video_id": resp["video_id"], "source_path": str(source.get("source_path")),
+                      "sha256": digest, "endpoint": "/upload/video", "uploaded_at": now_iso(),
+                      "response": resp}
+            cache[key] = stored
+            save_upload_cache(cache)
+            say("  source video uploaded: video_id=%s" % stored["video_id"])
+            source_rec = dict(stored, source="uploaded")
+        source_id = source_rec["video_id"]
+    return {"references": ref_ids, "source_video": source_id}, records, source_rec
+
