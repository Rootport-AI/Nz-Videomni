@@ -0,0 +1,122 @@
+# -*- coding: utf-8 -*-
+r"""The Single path must not move (2026-11-08, plan cozy-gliding-pudding §4.1 方針).
+
+The 12 Single plan files of the 2026-11-04 TE bench live in ``plans_te/``
+(moved out of ``plans/`` because this bench's own Single baseline is also
+called ``b1080`` -- a Ref2VA point, while the 11-04 ``p_b1080.json`` is the
+FL2VA one).  For each of them this script
+
+  1. runs ``calib.py preflight --plan plans_te/<file>`` IN PROCESS, with
+     ``calib.PLANS_DIR`` pointed at ``plans_te/`` (so the 11-04 baselines
+     b1080r / b1440 / b720r resolve as they did there) and ``PREFLIGHT_JSON``
+     pointed at ``selftest/single_regress_preflight.json``, and compares
+       * the return code and the printed lines (timestamps stripped) with the
+         11-04 bench's ``preflight_<label>.rc`` / ``preflight_<label>_output.txt``;
+       * the full preflight row (``keyframe_image`` folder normalised) with the
+         snapshot taken at S0 from the UNMODIFIED copy
+         (``selftest/single_regress_ref_rows.json``, written by ``--save-ref``);
+  2. runs ``calib.py run --dry-run --plan plans_te/<file>`` (the real CLI, a
+     subprocess) and compares ``dryrun/<label>.request.json`` BYTE FOR BYTE
+     with the 11-04 bench's ``dryrun/<label>.request.json``; the file is then
+     moved to ``dryrun_te/`` (a same-named file of this bench is put back), and
+     ``selftest/dryrun_validate.py dryrun_te`` must give 0 failures.
+
+  ..\..\..\.venv\Scripts\python.exe selftest\single_regress.py [--save-ref]
+"""
+from __future__ import annotations
+
+import contextlib
+import io
+import json
+import re
+import shutil
+import subprocess
+import sys
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+BENCH = HERE.parent
+sys.path.insert(0, str(BENCH))
+import calib  # noqa: E402
+
+TE = BENCH.parent / "comfort-calib-h3-2026-11-04-te"
+PLANS_TE = BENCH / "plans_te"
+REF_ROWS = HERE / "single_regress_ref_rows.json"
+PY = sys.executable
+STAMP = re.compile(r"^\[[^\]]*\] ")
+
+
+def norm_lines(text: str) -> list:
+    return [STAMP.sub("", ln.rstrip("\r")) for ln in text.splitlines()]
+
+
+def norm_row(row: dict) -> dict:
+    row = json.loads(json.dumps(row))
+    if row.get("keyframe_image"):
+        row["keyframe_image"] = Path(row["keyframe_image"]).name
+    return row
+
+
+def main() -> int:
+    save_ref = "--save-ref" in sys.argv[1:]
+    fails = []
+    rows_now = {}
+    calib.PLANS_DIR = PLANS_TE
+    calib.PREFLIGHT_JSON = HERE / "single_regress_preflight.json"
+    plan_files = sorted(PLANS_TE.glob("p_*.json"))
+    for plan_file in plan_files:
+        label = plan_file.stem[2:]
+        buf = io.StringIO()
+        with contextlib.redirect_stdout(buf):
+            rc = calib.main(["preflight", "--plan", str(plan_file)])
+        te_rc = int((TE / ("preflight_%s.rc" % label)).read_text(encoding="utf-8").strip())
+        te_lines = norm_lines((TE / ("preflight_%s_output.txt" % label)).read_text(encoding="utf-8"))
+        # the one line naming the report file: this script writes its own copy
+        now_lines = [ln.replace("wrote %s --" % calib.PREFLIGHT_JSON.name, "wrote preflight.json --")
+                     for ln in norm_lines(buf.getvalue())]
+        same_text = now_lines == te_lines
+        rep = json.loads(calib.PREFLIGHT_JSON.read_text(encoding="utf-8"))
+        rows_now[label] = [norm_row(r) for r in rep["plans"][plan_file.name]["rows"]]
+        if rc != te_rc or not same_text:
+            fails.append("preflight %s: rc %s (11-04 %s), text same=%s" % (label, rc, te_rc, same_text))
+        # dry-run through the real CLI
+        out = BENCH / "dryrun" / ("%s.request.json" % label)
+        keep = out.read_bytes() if out.exists() else None
+        proc = subprocess.run([PY, str(BENCH / "calib.py"), "run", "--dry-run", "--plan", str(plan_file)],
+                              capture_output=True, text=True, encoding="utf-8", errors="replace")
+        te_bytes = (TE / "dryrun" / ("%s.request.json" % label)).read_bytes()
+        got = out.read_bytes() if out.exists() else b""
+        (BENCH / "dryrun_te").mkdir(exist_ok=True)
+        if out.exists():
+            shutil.move(str(out), str(BENCH / "dryrun_te" / out.name))
+        if keep is not None:
+            out.write_bytes(keep)
+        if proc.returncode != 0 or got != te_bytes:
+            fails.append("dry-run %s: rc %s, bytes same as 11-04=%s" % (label, proc.returncode, got == te_bytes))
+        print("%-14s preflight rc=%s (11-04 %s) text=%s | dry-run rc=%s bytes=%s"
+              % (label, rc, te_rc, "same" if same_text else "DIFF", proc.returncode,
+                 "same" if got == te_bytes else "DIFF"))
+    if save_ref:
+        REF_ROWS.write_text(json.dumps(rows_now, indent=1, ensure_ascii=False), encoding="utf-8")
+        print("saved the S0 row snapshot -> %s" % REF_ROWS.name)
+    ref = json.loads(REF_ROWS.read_text(encoding="utf-8"))
+    for label in sorted(set(ref) | set(rows_now)):
+        if ref.get(label) != rows_now.get(label):
+            fails.append("preflight row %s differs from the S0 snapshot" % label)
+    print("preflight rows vs S0 snapshot: %s" % ("same" if not any("row" in f for f in fails) else "DIFF"))
+    proc = subprocess.run([PY, str(HERE / "dryrun_validate.py"), "dryrun_te"],
+                          capture_output=True, text=True, encoding="utf-8", errors="replace")
+    last = (proc.stdout.strip().splitlines() or [""])[-1]
+    te_val = (TE / "selftest" / "dryrun_validate_te_output.txt").read_text(encoding="utf-8")
+    same_val = norm_lines(proc.stdout) == norm_lines(te_val)
+    print("dryrun_validate dryrun_te: rc=%s %s (output same as 11-04: %s)" % (proc.returncode, last, same_val))
+    if proc.returncode != 0 or not same_val:
+        fails.append("dryrun_validate dryrun_te rc=%s same=%s" % (proc.returncode, same_val))
+    print("%d plan file(s), %d failure(s)" % (len(plan_files), len(fails)))
+    for f in fails:
+        print("  FAILED: %s" % f)
+    return 1 if fails else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
