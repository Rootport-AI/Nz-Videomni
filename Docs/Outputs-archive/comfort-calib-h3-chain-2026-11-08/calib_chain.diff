+# --- chain analysis (plan §4.1 S4) ---------------------------------------------
+# Window names of a chain point: "clip<i>.encode" (recorded only),
+# "clip<i>.denoise" (judged) for i = 0..n-1, and "decode" (judged, one for the
+# whole chain).  i is the 0-BASED clip index; server.log's "[i/n]" and the
+# worker's "chain: clip i/n" are 1-BASED (engine_h3/chain_h3.py:248 logs i + 1),
+# so log position p is clip p - 1 everywhere below.
+def h3_chain_window_names(n: int) -> tuple:
+    judged = tuple("clip%d.denoise" % i for i in range(n)) + ("decode",)
+    recorded = tuple("clip%d.encode" % i for i in range(n))
+    return judged, recorded
+
+
+def _h3_group_span(name: str, stage: str, grp) -> dict:
+    """h3_stage_window's span dict, for one given stage_groups() group."""
+    if not grp:
+        return {"name": name, "label": H3_STAGE_LABELS[stage], "found": False,
+                "start": None, "end": None}
+    done, total, elapsed = grp.get("last_done"), grp.get("total"), grp.get("log_elapsed")
+    out = {"name": name, "label": H3_STAGE_LABELS[stage], "found": True,
+           "start": grp["start_t"], "end": grp["end_t"],
+           "start_iso": grp["start_iso"], "end_iso": grp["end_iso"],
+           "lines": grp["lines"], "last_done": done, "total": total,
+           "log_elapsed_s": elapsed, "outer": grp.get("outer"),
+           "completed": bool(done is not None and total and done >= total)}
+    if stage == "denoise":
+        # H3: the started line comes before step 1 -> elapsed / last_done (h3_stage_window)
+        out["sec_per_step_log"] = rnd(elapsed / done, 3) if (elapsed is not None and done) else None
+    return out
+
+
+def h3_chain_stage_windows(events: list, n: int) -> dict:
+    """The chain's windows from server.log (plan §4.1 S4; material
+    logs/server.log job e8f0951d, 2026-11-02 22:35-22:56):
+
+    * ``clip<i>.denoise`` = the ``chain stage-1 denoise [i+1/n]`` group
+      (its ``started`` line -> its last line), one group per clip;
+    * ``decode`` = the one ``chain VAE decode`` group (h3_stage_window, reused);
+    * ``clip<i>.encode`` (recorded only): ``chain text encode`` carries no
+      ``[i/n]`` and the 2nd clip's encode continues the 1st one's counter
+      ("chain text encode 1/4 steps (... 553.4s elapsed)"), so the encode is cut
+      at the denoise boundaries: clip 0 = the first ``text encode`` line ->
+      ``denoise [1/n] started``; clip i >= 1 = the last line of denoise [i/n]
+      -> ``denoise [i+1/n] started``.  Without that next start (an OOM in the
+      encode) the window ends on the last ``text encode`` line after its start.
+    """
+    groups = {g["outer"]: g for g in stage_groups(events, H3_STAGE_LABELS["denoise"])}
+    spans = {}
+    den = [_h3_group_span("clip%d.denoise" % i, "denoise", groups.get(str(i + 1))) for i in range(n)]
+    enc_events = [ev for ev in events if ev.get("label") == H3_STAGE_LABELS["encode"]
+                  and ev.get("kind") in ("start", "progress")]
+    for i in range(n):
+        spans["clip%d.denoise" % i] = den[i]
+        name = "clip%d.encode" % i
+        if i == 0:
+            starts = [ev["t"] for ev in enc_events if ev["kind"] == "start"]
+            t0 = starts[0] if starts else (enc_events[0]["t"] if enc_events else None)
+        else:
+            t0 = den[i - 1].get("end") if den[i - 1].get("found") else None
+        if t0 is None:
+            spans[name] = {"name": name, "label": H3_STAGE_LABELS["encode"], "found": False,
+                           "start": None, "end": None}
+            continue
+        t1 = den[i].get("start") if den[i].get("found") else None
+        inside = [ev for ev in enc_events if ev["t"] >= t0 and (t1 is None or ev["t"] <= t1)]
+        if t1 is None:
+            t1 = inside[-1]["t"] if inside else None
+        last = inside[-1] if inside else {}
+        spans[name] = {"name": name, "label": H3_STAGE_LABELS["encode"], "found": t1 is not None,
+                       "start": t0, "end": t1, "start_iso": iso(t0), "end_iso": iso(t1),
+                       "lines": len(inside), "last_done": last.get("done"), "total": last.get("total"),
+                       "end_by": ("denoise [%d/%d] started" % (i + 1, n)) if den[i].get("found")
+                       else "last text encode line"}
+    dec = h3_stage_window(events, "decode")
+    dec["name"] = "decode"
+    spans["decode"] = dec
+    order = []
+    for i in range(n):
+        order += ["clip%d.encode" % i, "clip%d.denoise" % i]
+    order.append("decode")
+    return {k: spans.get(k) or {"name": k, "found": False, "start": None, "end": None} for k in order}
+
+
+def h3_chain_worker_text_tokens(tail: list) -> list:
+    """Every ``encode: N text tokens`` line of the job, in order (clip 0, 1, ...)."""
+    out = []
+    for row in tail:
+        match = H3_TEXT_TOKENS_RE.search(row.get("text") or "")
+        if match:
+            out.append({"text": int(match.group("n")),
+                        "references": int(match.group("k")) if match.group("k") else 0,
+                        "line": row["text"]})
+    return out
+
+
+def h3_chain_oom_clip(tail: list, events: list, error: str):
+    """The clip an OOM happened in (0-based).  The worker's last ``chain: clip
+    i/n`` line (h3_worker.log, 1-based: clip i - 1); without one, server.log's
+    last ``[i/n]`` (also 1-based).  An OOM whose traceback puts it in the decode
+    (one decode for the whole chain) has no clip: ``clip`` None, the last clip
+    started is still given."""
+    found = None
+    for row in tail:
+        match = H3_CHAIN_CLIP_RE.search(row.get("text") or "")
+        if match:
+            found = (int(match.group("i")), int(match.group("n")), "h3_worker.log 'chain: clip i/n'")
+    if found is None:
+        for ev in events:
+            if ev.get("outer"):
+                total = None
+                m = re.search(r"\[(\d+)/(\d+)\]", ev.get("msg") or "")
+                if m:
+                    total = int(m.group(2))
+                found = (int(ev["outer"]), total, "server.log '[i/n]'")
+    loc = h3_oom_location(error) if error else None
+    if found is None:
+        return {"clip": None, "log_position": None, "source": None,
+                "stage": (loc or {}).get("stage")}
+    in_decode = (loc or {}).get("stage") == "decode"
+    return {"clip": None if in_decode else found[0] - 1,
+            "last_clip_started": found[0] - 1,
+            "log_position": "%s/%s" % (found[0], found[1]),
+            "source": found[2], "stage": (loc or {}).get("stage"),
+            "note": "1-based in the logs; clip = log position - 1"}
+
+
+def h3_chain_used_from_meta(meta: dict) -> dict:
+    """h3_used_from_meta (top level: vram16 / attention / keep_resident /
+    prefetch / images_used (the chain's total) / steps / loras / transformer)
+    plus the chain's per-clip facts: ``dit_source`` per clip (clip 0 "file",
+    later ones "resident"), each clip's ``block_swap_prefetch_used``,
+    ``chain.num_clips`` / ``chain.clip_num_frames``; ``references`` is the
+    chain's {"clips": [block | None]} (absent = None when no clip has any)."""
+    used = h3_used_from_meta(meta)
+    clips = (((meta.get("h3") or {}).get("phases") or {}).get("clips")) or []
+    used["dit_source"] = [((c or {}).get("denoise") or {}).get("dit_source") for c in clips] or None
+    used["block_swap_prefetch_used_clips"] = [((c or {}).get("denoise") or {}).get("block_swap_prefetch_used")
+                                              for c in clips] or None
+    chain = meta.get("chain") or {}
+    used["chain_num_clips"] = chain.get("num_clips")
+    used["chain_clip_num_frames"] = chain.get("clip_num_frames")
+    used["kind"] = meta.get("kind")
+    return used
+
+
+def h3_chain_expected_references(point: dict):
+    """metadata.json's ``references`` for this chain: None when no clip has
+    references, else {"clips": [None | {pictures, videos, audios, inputs}]}
+    with the inputs as SENT (_request_sent; the ids from reference_uploads.json)."""
+    sent_clips = (point.get("_request_sent") or {}).get("clips")
+    blocks, any_ref = [], False
+    for i, clip in enumerate(point.get("clips") or []):
+        if sent_clips is not None and i < len(sent_clips):
+            sent = sent_clips[i].get("references") or []
+        else:
+            sent = [{"kind": r["kind"], "slot": int(r["slot"]), "id": None, "max_sec": r.get("max_sec")}
+                    for r in clip.get("references") or []]
+        if not sent:
+            blocks.append(None)
+            continue
+        any_ref = True
+        count = lambda k, s=sent: sum(1 for r in s if r["kind"] == k)
+        blocks.append({"pictures": count("picture"), "videos": count("video"), "audios": count("audio"),
+                       "inputs": [{"kind": r["kind"], "slot": int(r["slot"]), "id": r.get("id"),
+                                   "max_sec": r.get("max_sec")} for r in sent]})
+    return {"clips": blocks} if any_ref else None
+
+
+def used_check_h3_chain(point: dict, used: dict, completed: bool = True) -> dict:
+    """used_check_h3's rules for a chain (None = mismatch; absent loras = []):
+    the Single keys, plus dit_source per clip (["file", "resident", ...]: the
+    chain keeps the DiT between its clips, plan §1), the chain's clip count and
+    lengths, and the per-clip references.  keep_resident_used is "off" (not
+    sent; the request default)."""
+    accel = h3_accel(point)
+    n = len(point.get("clips") or [])
+    want = {
+        "vram16_mode_used": "on",
+        "attention_used": accel["attention_backend"],
+        "keep_resident_used": "off",
+        "images_used": len((point.get("keyframes") or {}).get("frame_idx") or []),
+        "loras": [{"name": s["name"], "strength": float(s.get("strength", 1.0))}
+                  for s in (point.get("loras") or [])],
+        "num_inference_steps": int(point["num_inference_steps"]),
+        "dit_source": ["file"] + ["resident"] * (n - 1),
+        "transformer_used": point.get("transformer") or "default",
+        "chain_num_clips": n,
+        "chain_clip_num_frames": [int(c["num_frames"]) for c in point.get("clips") or []],
+        "references": h3_chain_expected_references(point),
+    }
+    if not completed:
+        return {"expected": want, "mismatches": {}, "ok": None,
+                "not_applicable": "job did not complete: no metadata.json"}
+    mismatches = {}
+    for key, value in want.items():
+        actual = used.get(key)
+        if key == "loras":
+            if actual is None and not used.get("loras_present_in_metadata"):
+                actual = []
+            if ([(e.get("name"), rnd(e.get("strength"), 4)) for e in actual]
+                    != [(e["name"], rnd(e["strength"], 4)) for e in value]):
+                mismatches[key] = {"requested": value, "used": actual}
+            continue
+        if key == "references":
+            a = None if actual is None else [h3_references_cmp(b) for b in actual.get("clips") or []]
+            w = None if value is None else [h3_references_cmp(b) for b in value["clips"]]
+            if a != w:
+                mismatches[key] = {"requested": value, "used": actual}
+            continue
+        if actual is None or actual != value:
+            mismatches[key] = {"requested": value, "used": actual}
+    return {"expected": want, "mismatches": mismatches, "ok": not mismatches}
+
+
+def analyse_h3_chain(point: dict, monitors, job: dict, t_start: float,
+                     t_end: float, calib: dict, server_text: str) -> dict:
+    """v3'' for one H3 chain point (plan §4.1 判定 v3'' の連結版).  The point is
+    comfortable when it completed and NO clip has (1) an OOM, (2) a
+    clip<i>.denoise window -- or the chain's decode window -- with >= 10
+    samples whose shared-memory median sits >= +300 MB over the SAME window of
+    the arm's chain baseline (clip i vs clip i, decode vs decode), (3) a
+    ``block_swap_prefetch_used`` that is not "on".  ``causes`` says which stage
+    made a point not comfortable ("denoise" counts for the line's 2-way choice,
+    plan §3.3; "decode" does not: §4-49 material)."""
+    run_dir = monitors.out_dir
+    counts = token_counts_h3_chain(point)
+    n = counts["n_clips"]
+    wddm = read_wddm(monitors.wddm_csv)
+    dmon = read_dmon(monitors.dmon_txt)
+    tail = [r for r in monitors.tail_rows() if r["log"] == "h3"]
+    events = read_server_events(server_text)
+    job_id, status = job.get("job_id"), job.get("status")
+    error = job.get("error") or ""
+    completed = status == "completed"
+    meta, meta_path = {}, None
+    if job_id:
+        candidate = OUTPUTS / job_id / "metadata.json"
+        if candidate.exists():
+            meta_path = candidate
+            try:
+                meta = json.loads(candidate.read_text(encoding="utf-8"))
+                (run_dir / "metadata.json").write_text(
+                    json.dumps(meta, indent=2, ensure_ascii=False), encoding="utf-8")
+            except Exception:
+                meta = {}
+
+    # -- windows -------------------------------------------------------------
+    judged_names, recorded_names = h3_chain_window_names(n)
+    spans = h3_chain_stage_windows(events, n)
+    stats = {name: window_stats(wddm, dmon, span.get("start"), span.get("end"), calib)
+             for name, span in spans.items()}
+    is_baseline = not point.get("baseline_label")
+    base = baseline_v3dprime_from_manifest(point.get("baseline_label"))
+    windows = {}
+    for name in list(spans):
+        win = stats[name]
+        samples = win.get("wddm_samples") or 0
+        median = win.get("shared_median_mb")
+        base_median = (base.get(name) or {}).get("shared_median_mb")
+        judged = name in judged_names
+        enough = bool(win.get("evaluated") and samples >= MIN_WINDOW_SAMPLES and median is not None)
+        decidable = bool(judged and enough and base_median is not None)
+        if not win.get("evaluated"):
+            reason = "window not found"
+        elif samples < MIN_WINDOW_SAMPLES:
+            reason = "fewer than %d WDDM samples" % MIN_WINDOW_SAMPLES
+        elif not judged:
+            reason = "recorded only (plan §4.1)"
+        elif is_baseline:
+            reason = "baseline point"
+        elif base_median is None:
+            reason = "no baseline for this window"
+        else:
+            reason = None
+        windows[name] = {
+            "judged": judged, "shared_median_mb": median,
+            "shared_peak_mb": win.get("shared_peak_mb"),
+            "baseline_shared_median_mb": base_median,
+            "delta_mb": (rnd(median - base_median, 1)
+                         if (median is not None and base_median is not None) else None),
+            "wddm_samples": samples, "enough_samples": enough,
+            "seconds": win.get("seconds"), "decidable": decidable,
+            "reason_undecidable": None if decidable else reason,
+            "plateau": (median > base_median + RELATIVE_PLATEAU_MB) if decidable else None,
+            "start_iso": spans[name].get("start_iso"), "end_iso": spans[name].get("end_iso"),
+        }
+
+    # -- facts from metadata.json, clip by clip --------------------------------
+    used = h3_chain_used_from_meta(meta)
+    check = used_check_h3_chain(point, used, completed=completed and bool(meta))
+    h3 = meta.get("h3") or {}
+    phases = h3.get("phases") or {}
+    meta_clips = phases.get("clips") or []
+    steps = h3.get("num_inference_steps") or point.get("num_inference_steps")
+    worker_texts = h3_chain_worker_text_tokens(tail)
+    clip_facts = []
+    for i in range(n):
+        ph = meta_clips[i] if i < len(meta_clips) else {}
+        den = ph.get("denoise") or {}
+        read_s = (den.get("dit") or {}).get("read_seconds")
+        spm = None
+        if den.get("seconds") is not None and steps:
+            spm = rnd((float(den["seconds"]) - float(read_s or 0.0)) / float(steps), 3)
+        sequence = den.get("sequence")
+        wt = worker_texts[i] if i < len(worker_texts) else None
+        axes = h3_axes(counts["clips"][i], sequence, wt)
+        names = ("encode", "image_encode", "reference_encode", "source_encode", "denoise")
+        clip_facts.append({
+            "clip": i, "num_frames": counts["clip_frames"][i],
+            "phase_seconds": {k: (ph.get(k) or {}).get("seconds") for k in names},
+            "phase_peak_vram_mb": {k: (ph.get(k) or {}).get("peak_vram_mb") for k in names},
+            "phase_peak_vram_reserved_mb": {k: (ph.get(k) or {}).get("peak_vram_reserved_mb") for k in names},
+            "phase_commit_process_peak_gib": {k: (ph.get(k) or {}).get("commit_process_peak_gib")
+                                              for k in names},
+            "sequence": sequence,
+            "sequence_estimate": None if sequence else {
+                "video": axes["video"], "cond": axes["cond"], "audio": axes["audio"],
+                "ref_video": axes["ref_video"], "ref_audio": axes["ref_audio"],
+                "text": axes["text"], "total": axes["S"], "source": axes["S_source"]},
+            "axes": axes, "predict": counts["predict"]["clips"][i],
+            "worker_text_tokens": wt,
+            "vram16": den.get("vram16"),
+            "dit_source": den.get("dit_source"),
+            "dit_read_seconds": read_s,
+            "block_swap_prefetch_used": den.get("block_swap_prefetch_used"),
+            "mask": den.get("mask"),
+            "sec_per_step_meta": spm,
+            "sec_per_step_log": spans["clip%d.denoise" % i].get("sec_per_step_log"),
+            "reference_encode": ({k: (ph.get("reference_encode") or {}).get(k) for k in
+                                  ("seconds", "peak_vram_mb", "peak_vram_reserved_mb",
+                                   "commit_process_peak_gib", "references")}
+                                 if ph.get("reference_encode") else None),
+            "source_encode": ph.get("source_encode"),
+        })
+    dec = phases.get("decode") or {}
+    decode_facts = {k: dec.get(k) for k in ("seconds", "frames", "peak_vram_mb", "peak_vram_reserved_mb",
+                                            "commit_process_peak_gib", "rss_process_peak_gib",
+                                            "audio_samples", "vae_source")} if dec else None
+
+    # -- v3'' (chain) -----------------------------------------------------------
+    oom = error.startswith(H3_OOM_PREFIX)
+    oom_vram16 = bool(oom and H3_VRAM16_OOM_NEEDLE in error)
+    oom_location = h3_oom_location(error) if oom else None
+    oom_clip = h3_chain_oom_clip(tail, events, error) if oom else None
+    prefetch_requested = bool(h3_accel(point)["block_swap_prefetch"])
+    prefetch_degraded = None
+    if completed and meta:
+        per = used.get("block_swap_prefetch_used_clips") or []
+        prefetch_degraded = [i for i in range(n)
+                             if prefetch_requested and (per[i] if i < len(per) else None) != "on"]
+    reasons, causes = [], []
+    if is_baseline:
+        verdict = "smoke" if point.get("smoke") else "baseline"
+    elif not completed:
+        verdict = "oom" if oom else (status or "unknown")
+        if oom:
+            where = (oom_clip or {}).get("clip")
+            reasons.append(("oom_vram16" if oom_vram16 else "oom")
+                           + (":clip%s" % where if where is not None else ""))
+            causes.append((oom_location or {}).get("stage") or "unknown")
+    else:
+        for name in judged_names:
+            if windows[name]["plateau"]:
+                reasons.append("plateau:%s" % name)
+                causes.append("decode" if name == "decode" else "denoise")
+        for i in prefetch_degraded or []:
+            reasons.append("prefetch_degraded:clip%d" % i)
+            causes.append("denoise")
+        if reasons:
+            verdict = "uncomfortable"
+        elif all(windows[nm]["decidable"] for nm in judged_names):
+            verdict = "comfortable"
+        else:
+            verdict = "undecidable"
+    comfortable = True if verdict == "comfortable" else (
+        False if verdict in ("uncomfortable", "oom") else None)
+    causes = list(dict.fromkeys(causes))
+    baseline_health = None
+    if is_baseline:
+        baseline_health = {
+            "windows_have_enough_samples": {nm: windows[nm]["enough_samples"] for nm in judged_names},
+            "note": "a chain baseline: every judged window needs >= 10 samples "
+                    "(no past band for a chain)",
+        }
+    evidence = [r["text"] for r in tail
+                if ("out of memory" in r["text"].lower() or "OutOfMemory" in r["text"]
+                    or "VRAM 16GB" in r["text"])][:30]
+    generate_lines = [r["text"] for r in tail if "] generate_chain:" in r["text"]
+                      or r["text"].startswith("generate_chain:")]
+    clip_lines = [r["text"] for r in tail if H3_CHAIN_CLIP_RE.search(r["text"] or "")]
+    worker_conditions = {
+        "generate_line": generate_lines[-1] if generate_lines else None,
+        "clip_lines": clip_lines,
+        "text_tokens_lines": [w["line"] for w in worker_texts],
+        "load": point.get("_h3_worker_load"),
+        "request_sent": "see request_sent (= runs/<label>/request.json body)",
+    }
+    v3dp = {
+        "protocol": "v3'' chain (2026-11-08, plan cozy-gliding-pudding §4.1)",
+        "min_window_samples": MIN_WINDOW_SAMPLES,
+        "relative_plateau_mb": RELATIVE_PLATEAU_MB,
+        "is_baseline": is_baseline, "baseline_label": point.get("baseline_label"),
+        "oom": oom, "oom_vram16": oom_vram16, "oom_location": oom_location,
+        "oom_clip": oom_clip,
+        "prefetch_degraded": prefetch_degraded,
+        "judged_windows": list(judged_names), "recorded_windows": list(recorded_names),
+        "windows": windows, "reasons": reasons,
+        "causes": causes,
+        "cause": ("denoise" if "denoise" in causes else (causes[0] if causes else None)),
+        "denoise_caused": ("denoise" in causes) if not is_baseline else None,
+        "comfortable": comfortable, "verdict": verdict,
+        "baseline_health": baseline_health,
+    }
+    vram_opt = meta.get("vram_optimization") or {}
+    result = job.get("result") or {}
+    return {
+        "label": point["label"], "kind": "chain",
+        "base_model": point.get("base_model"), "engine": "h3",
+        "status": status, "job_id": job_id, "error": job.get("error"),
+        "geometry": {"width": point["width"], "height": point["height"],
+                     "clips": counts["clip_frames"], "num_frames": None,
+                     "keyframes": point.get("keyframes"),
+                     "source_video": point.get("source_video"),
+                     "clip_references": [c.get("references") or [] for c in point.get("clips") or []],
+                     "loras": point.get("loras"),
+                     "num_inference_steps": point.get("num_inference_steps"),
+                     "attention_backend": h3_accel(point)["attention_backend"],
+                     "seed": point.get("seed", DEFAULT_SEED)},
+        "tokens": counts,
+        "wall": {"start_iso": iso(t_start), "end_iso": iso(t_end),
+                 "start_epoch": rnd(t_start, 3), "end_epoch": rnd(t_end, 3),
+                 "seconds": rnd(t_end - t_start, 2)},
+        "request_sent": point.get("_request_sent"),
+        "keyframe_image_used": point.get("_keyframe_image_used"),
+        "reference_uploads_used": point.get("_reference_uploads_used"),
+        "source_video_used": point.get("_source_video_used"),
+        "predict": counts.get("predict"),
+        "used": used, "used_matches_request": check,
+        "metadata": {
+            "peak_vram_mb": vram_opt.get("peak_vram_mb"),
+            "peak_vram_reserved_mb": meta.get("peak_vram_reserved_mb"),
+            "generation_time_seconds": meta.get("generation_time_seconds"),
+            "seed_used": meta.get("seed_used"), "backend": meta.get("backend"),
+            "base_model": (meta.get("models") or {}).get("base_model"),
+            "models_selection": (meta.get("models") or {}).get("selection"),
+            "chain": meta.get("chain"),
+            "output_path": (meta.get("output") or {}).get("path") or result.get("output_path"),
+            "metadata_path": str(meta_path) if meta_path else None,
+        },
+        "h3": {"clips": clip_facts, "decode": decode_facts,
+               "commit_peak_gib": h3.get("commit_peak_gib"), "rss_peak_gib": h3.get("rss_peak_gib"),
+               "num_inference_steps": h3.get("num_inference_steps"),
+               "images_used": h3.get("images_used"), "loras": h3.get("loras"),
+               "seeds": h3.get("seeds"), "audio_latent_excess": h3.get("audio_latent_excess")},
+        "h3_spans": {name: {k: v for k, v in span.items() if k not in ("start", "end")}
+                     for name, span in spans.items()},
+        "vram": {"job": window_stats(wddm, dmon, t_start, t_end, calib),
+                 "windows": stats,
+                 "wddm_rows": len(wddm), "dmon_rows": len(dmon),
+                 "wddm_interval_ms_median": rnd(med([r["dt_ms"] for r in wddm[1:]]), 1),
+                 "worker_tail_rows": len(tail)},
+        "worker_log_evidence": evidence,
+        "worker_conditions": worker_conditions,
+        "worker_tail_last": [r["text"] for r in tail[-20:]] if not completed else None,
+        "v3dprime": v3dp, "verdict_v3dprime": verdict,
+        "baseline_v3dprime": base,
+        "calibration_used": {k: calib.get(k) for k in
+                             ("shared_p95_mb", "dedicated_p95_mb", "rxpci_p95", "txpci_p95")},
+    }
+
+
+H3_CHAIN_REPORT_COLS = ["label", "clip", "F", "K", "refs", "S", "S src", "text", "cap MiB",
+                        "dit src", "prefetch", "s/step meta", "s/step log", "denoise s",
+                        "den peak MB", "den res MB", "den Δ MB", "den n", "enc med MB", "enc n",
+                        "status", "v3''", "reasons", "causes", "oom clip", "oom stage",
+                        "dec s", "dec frames", "dec res MB", "dec Δ MB", "dec n",
