+# -*- coding: utf-8 -*-
+"""Print every plans/p_*.json point: kind, geometry, K, predicted S per clip, baseline
+(2026-11-08 chain bench, plan cozy-gliding-pudding §4.2), and compare with the plan's table."""
+import json, sys
+from pathlib import Path
+BENCH = Path(__file__).resolve().parent.parent
+# plan §4.2 (S = sequence.total incl. the 30-token prompt).  E clip 1: the bench's tokenizer value.
+TABLE = {"cb1080": [38984, 34896], "A1": [213348, 219516], "A1_r2": [213348, 219516],
+         "A-U": [223604, None], "B1": [217798, 210430], "B1_r2": [217798, 210430],
+         "A0": [213348, 209260], "A0_r2": [213348, 209260], "C1": [139882, 137954],
+         "D-K3": [219476], "D-K3_r2": [219476], "E": [101028, 217167],
+         "F": [219516, 219516], "B-U": [217798, 228886], "D-K4": [221516]}
+bad = 0
+for f in sorted((BENCH / "plans").glob("p_*.json")):
+    for p in json.loads(f.read_text(encoding="utf-8")):
+        if p.get("kind") == "chain":
+            s = [c["total"] for c in p["predict"]["clips"]]
+            geo = "%dx%d %s" % (p["width"], p["height"], [c["num_frames"] for c in p["clips"]])
+            extra = ("V2V " if p.get("source_video") else "") + " ".join(
+                "clip%d refs=%s" % (i, [(r["kind"], r["slot"], Path(r["source_path"]).name) for r in c["references"]])
+                for i, c in enumerate(p["clips"]) if c.get("references"))
+        else:
+            s = [p["predict"]["S_estimate"]]
+            geo = "%dx%d/%d single" % (p["width"], p["height"], p["num_frames"])
+            extra = ""
+        K = len((p.get("keyframes") or {}).get("frame_idx") or [])
+        want = TABLE.get(p["label"])
+        cmp_ = "" if want is None else ("match" if all(w is None or w == g for w, g in zip(want, s)) else "MISMATCH %s" % want)
+        bad += cmp_.startswith("MISMATCH")
+        role = p.get("baseline_label") or ("(smoke)" if p.get("smoke") else "(baseline)")
+        print("%-11s %-24s K=%d %-17s S=%-18s %-16s %s %s" % (p["label"], geo, K, p["transformer"][:17], s, role, cmp_, extra))
+print("%d mismatch(es)" % bad)
+sys.exit(1 if bad else 0)
