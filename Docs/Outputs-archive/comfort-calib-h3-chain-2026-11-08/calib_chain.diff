+#!/bin/bash
+# helper (H3 chain, 2026-11-08, 台帳 §1-276, plan cozy-gliding-pudding.md §4.1 S1 / S5):
+#   mkc.sh <label> <transformer> <sage|sdpa> <W> <H> <steps> <K of clip 0> <baseline label|FIRST|SMOKE> <F0> <F1> ...
+#          [--clip-ref i:kind:path:slot ...] [--source-video path] [--purpose "text"]
+# e.g. mkc.sh A1 minimax_h3_ref2va_pruned_int8_convrot sage 1920 1088 4 1 cb1080 345 362 --purpose "H3 chain A1 (arm A)"
+# The clip lengths are every numeric argument after the baseline; the rest goes to mkplan.py as is.
+# mk.sh stays for the Single points (arm D).  FIRST = this point IS its arm's baseline; SMOKE = smoke (no baseline).
+cd "S:/OriginalApps/12_Nz-LTX23-AviUtl2/Nz-Videomni/outputs/comfort-calib-h3-chain-2026-11-08" || exit 2
+export PYTHONIOENCODING=utf-8 PYTHONUTF8=1
+PY="../../.venv/Scripts/python.exe"
+label=$1; tr=$2; attn=$3; W=$4; H=$5; ST=$6; K=$7; bl=$8; shift 8
+CL=()
+while [ $# -gt 0 ] && [[ "$1" =~ ^[0-9]+$ ]]; do CL+=("$1"); shift; done
+EXTRA=("$@")
+[ ${#CL[@]} -ge 1 ] || { echo "mkc.sh: no clip lengths"; exit 1; }
+[ -n "$bl" ] || { echo "mkc.sh: missing <baseline label|FIRST|SMOKE>"; exit 1; }
+if [ "$bl" = FIRST ]; then BL=(--baseline-first); elif [ "$bl" = SMOKE ]; then BL=(--smoke); else BL=(--baseline "$bl"); fi
+"$PY" mkplan.py --out "p_${label}.json" --kind chain --label "$label" --base-model MiniMaxH3 --transformer "$tr" --attention $attn --width $W --height $H --clips "${CL[@]}" --steps $ST --keyframes $K "${BL[@]}" --tier H3 --purpose "H3 chain $label" "${EXTRA[@]}" || exit 1
+"$PY" calib.py preflight --plan "plans/p_${label}.json" > "preflight_${label}_output.txt" 2>&1; rc=$?
+tail -3 "preflight_${label}_output.txt"; echo preflight_rc=$rc
+echo $rc > "preflight_${label}.rc"
