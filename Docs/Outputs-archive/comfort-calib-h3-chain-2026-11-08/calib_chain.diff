+def h3_chain_report_cells(label: str, rec: dict) -> list:
+    """One row PER CLIP of a chain point (plan §4.1 S4), the LARGEST clip (by S)
+    first; the point-wide columns (verdict, decode, commit, used-check) are
+    filled on that first row only."""
+    v = rec.get("v3dprime") or {}
+    wins = v.get("windows") or {}
+    facts = rec.get("h3") or {}
+    clips = facts.get("clips") or []
+    tok = rec.get("tokens") or {}
+    w = lambda nm, k: (wins.get(nm) or {}).get(k)
+    order = sorted(range(len(clips)), key=lambda i: -((clips[i].get("axes") or {}).get("S") or 0))
+    dec = facts.get("decode") or {}
+    rows = []
+    for rank, i in enumerate(order):
+        c = clips[i]
+        vr = c.get("vram16") or {}
+        clip_refs = (rec.get("geometry") or {}).get("clip_references") or []
+        refs = ",".join("%s%s" % (str(r.get("kind"))[0], r.get("slot"))
+                        for r in (clip_refs[i] if i < len(clip_refs) else [])) or "-"
