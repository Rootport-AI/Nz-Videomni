+# -*- coding: utf-8 -*-
+r"""``calib.py run`` on chain points with NO server (2026-11-08, plan cozy-gliding-pudding §4.1 S5).
+
+cmd_run's chain branches (header line, the per-clip uploads of E / the source
+video of F, the one re-upload + resubmit on a 404 *_NOT_FOUND, the per-clip
+result lines) only run against a live server, so this drives cmd_run itself
+with every server-facing call replaced in process: api / api_multipart /
+port_open / discover_luid / active_transformer / poll_job / Monitors.  Every
+file it writes goes to a temp folder (RUNS / MANIFEST / reference_uploads.json
+/ calibration.json / OUTPUTS are pointed there); this bench's own state is not
+touched.  Checks: the bodies POSTed, the uploads made (each file once), the
+resubmit after REFERENCE_NOT_FOUND / SOURCE_VIDEO_NOT_FOUND, and that a
+run.json with verdict fields comes out.
+
+  ..\..\..\.venv\Scripts\python.exe selftest\run_chain_mock.py
+"""
+from __future__ import annotations
+
+import argparse
+import contextlib
+import io
+import json
+import shutil
+import sys
+import tempfile
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE.parent))
+import calib  # noqa: E402
+
+FAILURES, CHECKS = [], 0
+
+
+def check(name, got, want):
+    global CHECKS
+    CHECKS += 1
+    if got == want:
+        print("  ok   %-60s = %r" % (name, got))
+    else:
+        print("  FAIL %-60s got %r  want %r" % (name, got, want))
+        FAILURES.append(name)
+
+
+class FakeMonitors:
+    def __init__(self, out_dir, luid, tail_logs=True):
+        self.out_dir = Path(out_dir)
+        self.wddm_csv = self.out_dir / "wddm.csv"
+        self.dmon_txt = self.out_dir / "dmon.txt"
+
+    def start(self):
+        self.out_dir.mkdir(parents=True, exist_ok=True)
+        self.wddm_csv.write_text("timestamp,dedicated_mb,shared_mb,dt_ms\n", encoding="ascii")
+        self.dmon_txt.write_text("", encoding="ascii")
+
+    def stop(self, grace=0.0):
+        pass
+
+    def tail_rows(self):
+        return []
+
+    def slice_server_log(self):
+        return ""
+
+
+def run(labels, fail_first=None):
+    """cmd_run on plans/p_<label>.json with the fakes; returns (posts, uploads, records)."""
+    posts, uploads, state = [], [], {"failed": False}
+
+    def fake_api(method, path, body=None, timeout=1800.0):
+        if method == "GET" and path == "/status":
+            return 200, {"base_model": "MiniMaxH3", "pipeline_loaded": True}
+        if method == "POST" and path in ("/generate", "/generate/chain"):
+            posts.append((path, json.loads(json.dumps(body))))
+            if fail_first and not state["failed"]:
+                state["failed"] = True
+                return 404, {"error": {"code": fail_first, "message": "x"}}
+            return 200, {"job_id": "job-%d" % len(posts)}
+        return 500, {"raw": "unexpected %s %s" % (method, path)}
+
+    def fake_multipart(path, field, file_path, content_type=None):
+        uploads.append((path, Path(file_path).name))
+        key = {"/upload/image": "image_id", "/upload/video": "video_id", "/upload/audio": "audio_id"}[path]
+        return 200, {key: "%s-%d" % (key, len(uploads)), "stored_path": "uploads/x"}
+
+    saved = {k: getattr(calib, k) for k in ("api", "api_multipart", "port_open", "discover_luid",
+                                            "active_transformer", "poll_job", "Monitors", "RUNS",
+                                            "MANIFEST", "UPLOADS_JSON", "CALIB_JSON", "OUTPUTS",
+                                            "WORKER_LOGS")}
+    tmp = Path(tempfile.mkdtemp(prefix="h3chain_run_"))
+    try:
+        calib.api, calib.api_multipart = fake_api, fake_multipart
+        calib.port_open = lambda: True
+        calib.discover_luid = lambda refresh=False: {"chosen_luid": "0x0"}
+        calib.active_transformer = lambda: calib.H3_REF2VA_TRANSFORMER
+        calib.poll_job = lambda job_id, timeout=7200.0: {"job_id": job_id, "status": "completed", "error": None}
+        calib.Monitors = FakeMonitors
+        calib.RUNS, calib.MANIFEST = tmp / "runs", tmp / "manifest.jsonl"
+        calib.UPLOADS_JSON, calib.CALIB_JSON, calib.OUTPUTS = (tmp / "reference_uploads.json",
+                                                               tmp / "calibration.json", tmp / "outputs")
+        calib.WORKER_LOGS = dict(calib.WORKER_LOGS, h3=tmp / "no_h3_worker.log")
+        calib.CALIB_JSON.write_text(json.dumps({"shared_p95_mb": 150.0}), encoding="utf-8")
+        records = {}
+        for label in labels:
+            # a fresh plan copy in the temp folder (cmd_run reads the plan path as given)
+            plan = tmp / ("p_%s.json" % label)
+            shutil.copy(HERE.parent / "plans" / ("p_%s.json" % label), plan)
+            args = argparse.Namespace(plan=str(plan), dry_run=False, label_suffix="", refresh_luid=False,
+                                      cooldown=0.0, job_timeout="auto")
+            buf = io.StringIO()
+            with contextlib.redirect_stdout(buf):
+                rc = calib.cmd_run(args)
+            records[label] = {"rc": rc, "out": buf.getvalue(),
+                              "run": json.loads((calib.RUNS / label / "run.json").read_text(encoding="utf-8"))}
+        return posts, uploads, records
+    finally:
+        for k, v in saved.items():
+            setattr(calib, k, v)
+        shutil.rmtree(tmp, ignore_errors=True)
+
+
+print("cmd_run on chain points with fakes (no server)")
+posts, uploads, rec = run(["A1", "E", "F"])
+check("A1/E/F: rc 0", [rec[l]["rc"] for l in ("A1", "E", "F")], [0, 0, 0])
+check("every POST went to /generate/chain", sorted({p for p, _ in posts}), ["/generate/chain"])
+check("uploads: the key frame once (A1, reused by E), E's reference video once, F's source video once",
+      uploads, [("/upload/image", "keyframe_f0.png"), ("/upload/video", "H3-Ref-1080p-15s.mp4"),
+                ("/upload/video", "H3-Ref-1080p-15s.mp4")])
+check("A1 body: clip 0 image = the uploaded id, sage, 4 steps",
+      (posts[0][1]["clips"][0]["conditioning_images"], posts[0][1]["attention_backend"],
+       posts[0][1]["num_inference_steps"]), ([{"image_id": "image_id-1", "frame_idx": 0}], "sage", 4))
+check("E body: clip 1 carries the uploaded reference id, clip 0 none",
+      [c.get("references") for c in posts[1][1]["clips"]], [None, [{"kind": "video", "id": "video_id-2", "slot": 1}]])
+check("F body: source_video = the uploaded id, no image", (posts[2][1]["source_video"],
+                                                          "conditioning_images" in posts[2][1]["clips"][0]),
+      ({"video_id": "video_id-3"}, False))
+check("the header line names the chain", "H3 CHAIN 1920x1088 clips=[345, 362]" in rec["A1"]["out"], True)
