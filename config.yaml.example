# =============================================================================
# 設定ファイルのテンプレート（config.yaml.example）
#
# このファイルはテンプレートです。setup.bat / run.bat が、config.yaml が
# まだ無いときに、このファイルを config.yaml という名前で複製します。
#
# config.yaml は git の追跡対象外です（.gitignore を参照）。
# そのため、このテンプレートを書き換えても、実際に動いている環境の設定には
# 反映されません。動作を変えたいときは config.yaml のほうを編集してください。
#
# 【開発者向けの注意】
# config.yaml を変更したら、このファイルも必ず同じように直してください。
# 両者の同期を強制する仕組みはありません。config.yaml は開発を通じて繰り返し
# 更新され続けているファイルで、片方だけ直して忘れる事故が起きやすい場所です。
# =============================================================================

server:
  host: "127.0.0.1"
  port: 18620
  allow_all_cors: false
  api_key: null
  log_dir: "./logs"

model:
  # 本番経路は量子化トランスフォーマー（GGUF、または fp8／int8 の safetensors）
  # + 小単体 component ファイル（VAE / audio / text-projection）+ GGUF Gemma。
  # モノリス（一体型の checkpoint）と QAT Gemma は読み込まない。
  #
  # 【重要】既定の重みファイルのパスは、ここではなく「ベースモデル記述子」
  # （scripts/manifests/*.json）が正本です。トランスフォーマー・GGUF Gemma・
  # VAE 2種・text projection・アップスケーラー・tokenizer ディレクトリは、
  # 記述子の categories[].default_file と assets に書かれています。
  # ここに古い gguf_transformer_path / gemma_root などが残っていても、
  # 起動時に警告が出るだけで値は使われません（削除して構いません）。
  checkpoint_name: "ltx-2.3-22b-distilled-1.1"
  pipeline_type: "distilled"
  auto_load_on_generate: true

  # ランタイムの選択。
  backend: "auto"                  # auto | mock | real（auto: エンジン環境と必要なモデルファイルが揃えば real, 欠ければ mock。GPU の有無は見ない）

  # ベースモデル記述子の置き場と、モデル置き場のルート。記述子の中のパスは
  # すべて models_dir からの相対で書かれている（この2つだけが「どこを見るか」
  # の設定で、「何を見るか」は記述子側）。
  manifest_dir: "./scripts/manifests"
  models_dir: "./models"

  # IC-LoRA アダプタ登録。API の GenerateRequest.loras[].name は
  # ここに登録された「名前」で解決する（生パスは受けない）。model.lora_dir に置いた
  # .safetensors もファイル名（拡張子なし）の名前で選べる。ここにも lora_dir にも
  # 1 つも無いときは loras 要求を全て拒否（fail loud）。
  ic_loras:
    # 文字列値 = preprocess none（参照動画を前処理せずに渡す）
    pixel-spatial-upscaler-x2: "./models/LTX23/IC-LoRA/pixel-spatial-upscaler/ltx-2.3-22b-ic-lora-pixel-spatial-upscaler-x2-0.9.safetensors"
    # 同一 Union-Control ファイルを複数の論理名で公開し preprocess で切替
    canny-control:
      path: "./models/LTX23/IC-LoRA/union-control/ltx-2.3-22b-ic-lora-union-control-ref0.5.safetensors"
      preprocess: canny
    pose-control:
      path: "./models/LTX23/IC-LoRA/union-control/ltx-2.3-22b-ic-lora-union-control-ref0.5.safetensors"
      preprocess: dwpose
    depth-control:
      path: "./models/LTX23/IC-LoRA/union-control/ltx-2.3-22b-ic-lora-union-control-ref0.5.safetensors"
      preprocess: depth
    # 前処理不要の制御アダプタ（ぼけた参照動画をそのまま渡す）＝文字列形式
    deblur: "./models/LTX23/IC-LoRA/deblur/ltx-2.3-22b-ic-lora-deblur-0.9.safetensors"
    # Outpainting（画面の描き足し）。公式 In-Outpainting IC-LoRA。
    # 参照として渡すのは「緑で外周を塗ったキャンバス動画」で、これを canny や
    # depth に変換してはいけない（緑は前処理の対象ではなくセンチネル）ため、
    # preprocess を持たない文字列形式で登録する。ヘッダに
    # reference_downscale_factor=1 があるので registry が control に自動分類する。
    in-outpainting: "./models/LTX23/IC-LoRA/in-outpainting/ltx-2.3-22b-ic-lora-in-outpainting-0.9.safetensors"
    # Alpha Gen（RGB 動画から白黒のマット動画を作る）。LTX 2.5 専用。
    # POST /generate/alpha が内部で使う（プロンプト・強さはサーバーが固定する）。
    # 操作パネルと Gradio の一覧には出ない。参照は前処理しないので文字列形式で
    # 登録する。配布方法は台帳 §1-87。
    alpha-gen: "./models/LTX25/IC-LoRA/alpha-gen/ltx-2.5-22b-ic-lora-alpha-gen-0.9.safetensors"

vram:
  # 主要開発環境が VRAM 16GB であるため有効にしている。
  low_vram_mode: true
  low_vram_profile: "16gb_safe"

  # fp8_transformer / cpu_offload_text_encoder は凍結API契約。
  # services/low_vram.py 経由で GET /status・metadata.json に出力されるため保持必須。
  # ただし worker へは非伝播: fp8 は runtime の device_supports_fp8 自動判定、
  # CPU text-encode オフロードは別フィールド te_offload_text_encoder（LTX_TE_OFFLOAD）で駆動。
  # fp8_transformer は、fp8 safetensors を置いて使う機能（README「追加の transformer
  # （GGUF／量子化 safetensors）」・Docs/VERIFICATION_LOG.md §117〜§119）とは無関係。
  # ComfyUI 標準の int8 safetensors（int8_tensorwise・asym_w4a8_int8）を置いて使う機能も、
  # fp8 と同じ経路（sft_quant_format.py の検査・dit_cpu_load の CPU 構築）を通るだけで、
  # この fp8_transformer フラグとは同様に無関係（Docs/VERIFICATION_LOG.md §121）。
  fp8_transformer: true
  cpu_offload_text_encoder: true
  te_offload_text_encoder: true   # 逐次レイヤーCPUオフロード（GGUF Gemma）。encode peak ~15GB→数GB。compute は GPU 維持。
  dit_cpu_load: true              # transformer を CPU 構築し非ブロックのみ GPU へ。ロード時 GPU スパイク ~16.9GB を除去。
  vae_tiling: true

  # attention_tiling / block_swap は worker へは渡らない
  # （どちらも GET /status の表示用）。実際の block swap は
  # block_swap_blocks_on_gpu（GPU に残すブロック数）が決める。
  attention_tiling: false
  block_swap: true
  block_swap_blocks_on_gpu: 8
  # VAE tiling sizes for the real GGUF engine（720p を 16GB に収めるため）。
  # config.py VramConfig が両フィールドを保持（vae_spatial_tile_size /
  # vae_temporal_tile_size, int, default 0）。
  vae_spatial_tile_size: 512
  vae_temporal_tile_size: 64

# 生成サイズ(width/height)は必ず64の倍数(two-stage distilled)。最終表示サイズは crop_output で。
generation_presets:
  smoke_test:
    width: 384
    height: 256
    crop_output: null
    num_frames: 17
  minimal:
    width: 512
    height: 320
    crop_output: null
    num_frames: 481
  small:
    width: 960
    height: 576
    crop_output:
      width: 960
      height: 540
    num_frames: 481 # わずかな共有メモリ使用は速度低下しない無害なベースライン（Docs/RESOLUTION_DURATION_CAPABILITY.md §8.2）のため 481
  standard_720p:
    width: 1280
    height: 768
    crop_output:
      width: 1280
      height: 720
    num_frames: 345 # 2.3 4bit の線 42,840 に収まる値（Docs/COMFORT_LIMIT_TABLE.md 第 1 節）
  FHD_1080p:
    width: 1920
    height: 1088
    crop_output:
      width: 1920
      height: 1080
    num_frames: 161 # 2.3 4bit の線 42,840 に収まる値（Docs/COMFORT_LIMIT_TABLE.md 第 1 節）
  WQHD_1440p:
    width: 2560
    height: 1472
    crop_output:
      width: 2560
      height: 1440
    num_frames: 81 # 2.3 4bit の線 42,840 に収まる値（Docs/COMFORT_LIMIT_TABLE.md 第 1 節）

generation_defaults:
  # 操作パネル（WebUI）のフォームの初期値（Gradio と API の既定値には効かない）。
  # standard_720p プリセットと幅・高さ・尺を一致させる。width/height は64の倍数。
  width: 1280
  height: 768
  crop_output: null   # 既定OFF。プリセット選択時はプリセットの値が適用される。
  num_frames: 345
  frame_rate: 24.0
  num_inference_steps: 8
  guidance_scale: 1.0
  seed: -1
  pipeline: "distilled"
  conditioning_images: []

upload:
  dir: "./uploads"
  max_image_size_mb: 20
  allowed_image_extensions: [".png", ".jpg", ".jpeg", ".webp"]
  # 参照動画アップロード（POST /upload/video）。受け取ったまま保存する（切り出しの窓や
  # max_frames の上限が指定されたときだけ切り出す）。
  max_video_size_mb: 200
  allowed_video_extensions: [".mp4", ".mov", ".webm", ".mkv"]
  # 音声アップロード（A2V, POST /upload/audio）。再エンコードせず保存。コーデック
  # 検査は preflight（ffprobe）が担当。ここは拡張子とサイズのみ。
  max_audio_size_mb: 50
  allowed_audio_extensions: [".wav", ".mp3", ".m4a", ".aac", ".flac", ".ogg"]

limits:
  # 生成の幅・高さ・フレーム数の上限。/config で公開し、Gradio の連結の事前検査（幅・高さ）と
  # 操作パネルが使う。サーバの範囲検査は api/models.py の Field の固定値（幅・高さ 4096、
  # フレーム数 481）で行い、ここの値は /config で配信されるだけ（サーバの検査には効かない）。
  max_width: 4096
  max_height: 4096
  max_num_frames: 481        # 20s@24fps(481=8×60+1)。溢れ/低速/非実用はクライアント警告に委ねる（Docs/RESOLUTION_DURATION_CAPABILITY.md §8.4/§8.6）。
  # /config で公開：キーフレームのlatent-frame-startグリッド。frame_idx 0=先頭フレーム
  # (latent-replace)。それ以外は offset + multiple*n = 8n+1 (1,9,17,…) にスナップ。
  # サーバー snap: (f-1)//8*8+1 を範囲クランプ。
  conditioning_frame_idx_multiple: 8
  conditioning_keyframe_grid_offset: 1
  phase1_max_concurrent_jobs: 1
  low_vram_disabled_required: false
  # LTX 2.3 の既定構成での実測（判定規則v3）。正本は Docs/COMFORT_LIMIT_TABLE.md
  spill_free_frames:         # 当初の実測は RESOLUTION_DURATION_CAPABILITY §8.4。超えると shared へ溢れ~2-4x低速(OOMせず)→UIで警告
    "512x320": 481           # minimal（20s@24fps 上限）
    "960x576": 481           # small（わずかな共有メモリ使用は速度低下しない無害なベースライン（Docs/RESOLUTION_DURATION_CAPABILITY.md §8.2）のため 481）
    "1280x768": 273          # 720p（実用快適上限）
    "1920x1088": 161         # 1080p（20s は非実用~40分→720p生成+外部upscale 推奨）
    "2560x1472": 81          # 1440p
  # V2V 継続（POST /generate/chain の source_video.context_frames）。/config で公開。
  # context_frames は 8n+1。max=145 は保守的な上限（凍結ヘッドを stage-2 の
  # 1タイル内に収める。api.models.SourceVideoSpec 参照）。
  # サーバの範囲検査は config.py の LimitsConfig の既定値で行い、ここの値は /config で
  # 配信されるだけ（サーバの検査には効かない。Gradio の事前検査と操作パネルが使う）。
  v2v_context_frames_default: 73
  v2v_context_frames_min: 25
  v2v_context_frames_max: 145
  # 素材（末尾）（POST /generate/chain の end_source.context_frames）。/config で公開。
  # 2 本以上で素材（冒頭）が無ければ逆順Chained（reverse）、素材（冒頭）があれば
  # ブリッジモード（bridge。全クリップ正順・最終クリップだけ両側条件付け）。どちらも
  # 末尾の凍結フレームは最終クリップ自身の末尾にあり、出力の尺は変わらない。
  # internal_segment（帯を足して出力を伸ばす方式）はAPIから到達不能。クリップ 1 本なら in_window＝
  # 末尾の凍結フレームはクリップの内側にあり出力の尺は変わらない。既定の 72 は契約上の
  # 既定値であって推奨値ではない。実機比較の結論は錨 8 フレームで、フロントエンドは常に 8 を
  # 明示送信する。正本は Docs/VERIFICATION_LOG.md §61・§63・§64・§102 と api.models.EndSourceSpec。
  # 8 の倍数（8n+1 ではない。末尾の凍結フレームは因果 VAE のキーフレーム潜在に触れず、
  # 末尾から 8 個組で数えるため。chain_math.v_tail_latents 参照）。
  # 136 は自動決定される凍結フレーム数の上限であって、幾何の上限ではない。136 = 17 潜在
  # フレーム ≒ 24fps で 5.67 秒。末尾の凍結フレームは 3 モードとも最終クリップ自身の末尾に
  # あり、stage-2 の潜在クリップを何個またいでもよいため（凍結計画の正本は chain_math の
  # end_tile_bands）、潜在クリップごとの上限は無い。
  # 136 は未計測領域を避けるための運用上限で、stage-2 のどのプリセットでも同じ値。
  # サーバの範囲検査は config.py の LimitsConfig の既定値で行い、ここの値は /config で
  # 配信されるだけ（サーバの検査には効かない）。引き上げるときは config.py の変更に
  # 加えて実機での品質確認が要る。既定 72 は契約上の既定値で、フロントエンドは常に 8 を送る。
  end_context_frames_default: 72
  end_context_frames_min: 8
  end_context_frames_max: 136
  # Retake の窓長（POST /generate/chain の clips[0].num_frames）。/config で公開。
  # いずれも 8n+1。169 = stage-2 の 1 窓に収まる最大（standard 窓 v_tile=22）。
  # 上限は選んだ Stage-2 の窓で決まり、窓の式 8×潜在フレーム数−7 で求まる
  # （high_resolution 窓 v_tile=19 なら 145。窓の一覧の正本は chain_math.py の
  # STAGE2_WINDOW_PRESETS と Docs/COMFORT_LIMIT_TABLE.md 第12節）。サーバはこの式で
  # 範囲を検査し、範囲外は 422 で拒否する。操作パネルは上限の配信値を読まず、同じ式で
  # 上限を求める（型と既定値は配信値の写しとして残っている）。
  # 下限 73 も上限もサーバの検査は chain_math の定数と式（RETAKE_WINDOW_MIN_PX・
  # retake_max_window_px）で行い、ここの値は /config で配信されるだけ（サーバの検査には
  # 効かない。操作パネルは下限の配信値を窓の下限に使う）。
  retake_window_min_frames: 73
  retake_window_max_frames: 169
  # 快適な stage-2 1 窓あたりの注意トークン上限。/config で公開する。サーバはこの値で
  # 何も判定しない（拒否も丸めもしない）純粋な助言値。トークン = (幅//32) × (高さ//32) × 窓の潜在フレーム数。
  # クライアントは目安線を、まず limits.comfort_budgets（ベースモデルごとの表）から
  # エンジン・重みの種別（4bit／8bit／Q6_K）・高速化設定に合う行を引き、合う行が無いとき
  # （表が無い・エンジンや種別が未確定・LTX 2.3 の 4bit／Q6_K で 5 つの高速化トグルの一部が
  # off など）にこの値へ戻る（互換値）。comfort_budgets の正本はマニフェスト
  # （scripts/manifests/*.json の comfort）。ここ（config.yaml）に comfort_budgets を書いても
  # 無視され、起動時に WARNING が出る。値と経緯は Docs/COMFORT_LIMIT_TABLE.md 第 1 節。
  # この鍵は書かなければ config.py の既定値（chain_math の CHAIN_COMFORT_TOKEN_BUDGET＝40000）が
  # 配信され、書くとその値で固定される（将来の定数調整が届かなくなる）ので、下の行は例示として
  # コメントアウトしてある。
  # chain_comfort_token_budget: 40000
  # Create（単発 `/generate`）1 発が快適に収まる注意トークン上限。/config で公開。
  # chain_comfort_token_budget とは別軸（1 発は stage-2 タイル分割なしで全体を
  # 1 パスで精製するため、ワークロードが異なる）。サーバはこの値で何も判定しない
  # 純粋な助言値。式は同じ: トークン = (幅//32) × (高さ//32) × 潜在フレーム数。
  # WebUI の Create 画面がこの値を使うのは、limits.comfort_budgets の表が配信されて
  # いないとき、またはエンジンが未確定のとき。そのときは 5 つの高速化トグル（sage・
  # block_swap_prefetch・keep_resident・fused_gguf_dequant_kernel・vae_mode=prune_vaed）
  # が全て on ならこの値から賢いマーカーを算出し、1 つでも off なら
  # spill_free_frames へフォールバックする。44,880 は重みの種別を区別していなかった
  # ころの旧配信値で、いまは表を知らない古いクライアントと起動直後の一瞬だけに使われる
  # 互換値。現在の線は種別ごとの表（正本はマニフェストの comfort、読み方は
  # Docs/COMFORT_LIMIT_TABLE.md 第 1 節）。
  #
  # 注意: この鍵も書かなければ config.py の既定値（44880）が配信され、書くとその値で
  # 固定される（将来の定数調整が実機に届かなくなる）。chain_comfort_token_budget と同じく、
  # 下の行は例示としてコメントアウトしてある。
  # single_comfort_token_budget: 44880

output:
  dir: "./outputs"
  save_metadata_json: true
  keep_raw_frames: false
