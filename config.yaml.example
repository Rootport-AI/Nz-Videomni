# =============================================================================
# 設定ファイルのテンプレート（config.yaml.example）
#
# このファイルはテンプレートです。setup.bat / run.bat が、config.yaml が
# まだ無いときに、このファイルを config.yaml という名前で複製します。
#
# config.yaml は git の追跡対象外です（.gitignore を参照）。
# そのため、このテンプレートを書き換えても、実際に動いている環境の設定には
# 反映されません。動作を変えたいときは config.yaml のほうを編集してください。
#
# 【開発者向けの注意】
# config.yaml を変更したら、このファイルも必ず同じように直してください。
# 両者の同期を強制する仕組みはありません。config.yaml は開発を通じて繰り返し
# 更新され続けているファイルで、片方だけ直して忘れる事故が起きやすい場所です。
# =============================================================================

server:
  host: "127.0.0.1"
  port: 18620
  allow_all_cors: false
  api_key: null
  log_dir: "./logs"

model:
  # 本番経路は GGUF 量子化トランスフォーマー + 小単体 component ファイル
  # （VAE / audio / text-projection）+ GGUF Gemma。43GB モノリスと QAT Gemma の
  # 実読み込みは廃止済み。QAT gemma_root は重み glob バイパス（gemma_root=None 構築）で
  # tokenizer 群のみ必要になった（下記 checkpoint_path / gemma_root のインライン注記参照）。
  checkpoint_dir: "./models"
  checkpoint_name: "ltx-2.3-22b-distilled-1.1"
  text_encoder: "google/gemma-3-12b-it-qat-q4_0-unquantized"
  pipeline_type: "distilled"
  auto_load_on_generate: true
  reload_interval: 0

  # ランタイムパス。services/ltx_runner.py（→ engine worker payload）のみが参照。
  # これらは DistilledPipeline 構築のために worker payload に載るが、GGUF +
  # component 経路では重みとして開かれない（下記インライン注記の通り）。
  # 相対パス（PROJECT_ROOT基準でconfig._absが絶対化）。
  ltx_repo_dir: "./vendor/LTX-2"   # reference only（上流LTX-2クローン）。
  # 2026-07-28 削除済み（PENDING_TASKS.md §3-26）: ここには以前 checkpoint_path
  # キー（43GB モノリスの参照専用パス、Stage3 で物理削除済み）があった。調査の結果
  # 完全に無害な死んだ設定と確定したため削除した——services/ltx_runner.py は
  # このキーが未設定のときも常に worker payload の checkpoint_path を ""（空文字）
  # として送っており（実運用で他の値になったことは一度も無い）、DistilledPipeline
  # 側もその文字列を一切開かない。渡す理由は「None でない str」であることだけ
  # （ModelLedger.build_model_builders が checkpoint_path is not None を条件に
  # 後で dataclasses.replace で上書きされる遅延ビルダーを作るため）で、""でその
  # 条件は満たされる。services/ltx_runner.py 側は同じ "" を直接ハードコードして
  # いるので、この設定を削除しても worker payload はバイト同一のまま。
  spatial_upsampler_path: "./models/ltx-2.3/ltx-2.3-spatial-upscaler-x2-1.1.safetensors"
  # GGUF Gemma 経路では tokenizer 群のみ必要。DistilledPipeline を gemma_root=None で
  # 構築し wheel の重み glob（model*.safetensors）をバイパス済 → Gemma LM 重みは GGUF 供給、
  # text-only（Gemma3ForCausalLM）なので vision 構造は存在しない。engine 側が shard 抜き
  # builder を組み直し、tokenizer/processor の
  # module_ops をこの dir から読む（tokenizer.model + preprocessor_config.json のみ glob）。
  # 実体は ~40MB の tokenizer-only dir（旧 22.7GB QAT dir は回収済＝物理削除, merge 826e76f）。
  gemma_root: "./models/gemma-3-12b-it-tokenizer"
  backend: "auto"                  # auto | mock | real（auto: GPU+モデル有→real, 無→mock）

  # IC-LoRA アダプタ登録（Phase B、Phase C で拡張）。API の GenerateRequest.loras[].name は
  # ここに登録された「名前」で解決する（生パスは受けない）。セクション不在＝loras 要求は
  # 全て拒否（fail loud）。
  ic_loras:
    # 後方互換: 文字列値 = preprocess none（Phase B のまま動く）
    pixel-spatial-upscaler-x2: "./models/ltx-2.3-ic-lora/pixel-spatial-upscaler/ltx-2.3-22b-ic-lora-pixel-spatial-upscaler-x2-0.9.safetensors"
    # Phase C: 同一 Union-Control ファイルを2つの論理名で公開し preprocess で切替
    canny-control:
      path: "./models/ltx-2.3-ic-lora/union-control/ltx-2.3-22b-ic-lora-union-control-ref0.5.safetensors"
      preprocess: canny
    pose-control:
      path: "./models/ltx-2.3-ic-lora/union-control/ltx-2.3-22b-ic-lora-union-control-ref0.5.safetensors"
      preprocess: dwpose
    depth-control:
      path: "./models/ltx-2.3-ic-lora/union-control/ltx-2.3-22b-ic-lora-union-control-ref0.5.safetensors"
      preprocess: depth
    # 前処理不要の制御アダプタ（ぼけた参照動画をそのまま渡す）＝文字列形式
    deblur: "./models/ltx-2.3-ic-lora-deblur/ltx-2.3-22b-ic-lora-deblur-0.9.safetensors"
    # Outpainting（画面の描き足し, §1-13）。公式 In-Outpainting IC-LoRA。
    # 参照として渡すのは「緑で外周を塗ったキャンバス動画」で、これを canny や
    # depth に変換してはいけない（緑は前処理の対象ではなくセンチネル）ため、
    # preprocess を持たない文字列形式で登録する。ヘッダに
    # reference_downscale_factor=1 があるので registry が control に自動分類する。
    in-outpainting: "./models/ltx-2.3-ic-lora-in-outpainting/ltx-2.3-22b-ic-lora-in-outpainting-0.9.safetensors"

vram:
  # Phase 1 から有効。主要開発環境がVRAM 16GBであるため。
  low_vram_mode: true
  low_vram_profile: "16gb_safe"

  # fp8_transformer / cpu_offload_text_encoder は凍結API契約。
  # services/low_vram.py 経由で GET /status・metadata.json に出力されるため保持必須。
  # ただし worker へは非伝播: fp8 は runtime の device_supports_fp8 自動判定、
  # CPU text-encode オフロードは別フィールド te_offload_text_encoder（LTX_TE_OFFLOAD）で駆動。
  fp8_transformer: true
  cpu_offload_text_encoder: true
  te_offload_text_encoder: true   # 逐次レイヤーCPUオフロード（GGUF Gemma）。encode peak ~15GB→数GB。compute は GPU 維持。
  dit_cpu_load: true              # transformer を CPU 構築し非ブロックのみ GPU へ。ロード時 GPU スパイク ~16.9GB を除去。
  vae_tiling: true

  # Phase 2 以降の高度な独自最適化。Phase 1 では無効。
  attention_tiling: false
  attention_tile_size: null
  block_swap: true
  block_swap_blocks_on_gpu: 8
  # VAE tiling sizes for the real GGUF engine（720p を 16GB に収めるため）。
  # config.py VramConfig が両フィールドを保持（vae_spatial_tile_size /
  # vae_temporal_tile_size, int, default 0）。
  vae_spatial_tile_size: 512
  vae_temporal_tile_size: 64

  # Path B: VAE/audio/text-projection を 46GB モノリスでなく小単体ファイルから読む。
  # keep_resident=0（ジョブ毎再materialize）でも commit を束縛し、マルチジョブ連続
  # 生成の commit 枯渇 native crash を防ぐ（§9.6 / §8）。720p+連続生成の両立に必須。
  # ※keep_resident は 2026-08-03 から per-job フィールド化（POST /generate・
  #   /generate/chain の keep_resident・既定 false）。Docs/VERIFICATION_LOG.md §48。
  use_component_files: true

  # 高VRAM環境向けの任意検証用。16GBでの成功は保証しない。
  allow_disable_low_vram: true

# 生成サイズ(width/height)は必ず64の倍数(two-stage distilled)。最終表示サイズは crop_output で。
generation_presets:
  smoke_test:
    width: 384
    height: 256
    crop_output: null
    num_frames: 17
  minimal:
    width: 512
    height: 320
    crop_output: null
    num_frames: 481
  small:
    width: 960
    height: 576
    crop_output:
      width: 960
      height: 540
    num_frames: 481 # G4でわずかな共有メモリ使用を観測したが、ログ確認により速度低下しない無害なベースライン（RESOLUTION_DURATION_CAPABILITY.md §8.2）と確定し481へ復帰（2026-07-20）
  standard_720p:
    width: 1280
    height: 768
    crop_output:
      width: 1280
      height: 720
    num_frames: 257 # limits.spill_free_frames["1280x768"] 実測快適上限と一致
  FHD_1080p:
    width: 1920
    height: 1088
    crop_output:
      width: 1920
      height: 1080
    num_frames: 153
  WQHD_1440p:
    width: 2560
    height: 1472
    crop_output:
      width: 2560
      height: 1440
    num_frames: 81

generation_defaults:
  # Gradio/API の初期値。standard_720p プリセットと完全一致させる。width/height は64の倍数。
  width: 1280
  height: 768
  crop_output: null   # 既定OFF。プリセット選択時はプリセットの値が適用される。
  num_frames: 257
  frame_rate: 24.0
  num_inference_steps: 8
  guidance_scale: 1.0
  seed: -1
  pipeline: "distilled"
  conditioning_images: []

upload:
  dir: "./uploads"
  max_image_size_mb: 20
  allowed_image_extensions: [".png", ".jpg", ".jpeg", ".webp"]
  normalize_to_png: true
  # 参照動画アップロード（Phase B, POST /upload/video）。再エンコードせず保存。
  max_video_size_mb: 200
  allowed_video_extensions: [".mp4", ".mov", ".webm", ".mkv"]
  # 音声アップロード（A2V, POST /upload/audio）。再エンコードせず保存。コーデック
  # 検査は preflight（ffprobe）が担当。ここは拡張子とサイズのみ。
  max_audio_size_mb: 50
  allowed_audio_extensions: [".wav", ".mp3", ".m4a", ".aac", ".flac", ".ogg"]

limits:
  max_width: 4096
  max_height: 4096
  max_num_frames: 481        # 20s@24fps(481=8×60+1)。溢れ/低速/非実用はクライアント警告に委ねる（§8.4/§8.6）。
  max_conditioning_images: 5
  # /config で公開：キーフレームのlatent-frame-startグリッド。frame_idx 0=先頭フレーム
  # (latent-replace)。それ以外は offset + multiple*n = 8n+1 (1,9,17,…) にスナップ。
  # サーバー snap: (f-1)//8*8+1 を範囲クランプ。
  conditioning_frame_idx_multiple: 8
  conditioning_keyframe_grid_offset: 1
  phase1_max_concurrent_jobs: 1
  low_vram_disabled_required: false
  spill_free_frames:         # 16GB 実測(§8.4)。超えると shared へ溢れ~2-4x低速(OOMせず)→UIで警告
    "512x320": 481           # minimal（20s@24fps 上限）
    "960x576": 481           # small（G4でわずかな共有メモリ使用を観測したが、ログ確認により速度低下しない無害なベースライン（§8.2）と確定し481へ復帰、2026-07-20）
    "1280x768": 257          # 720p（実用快適上限）
    "1920x1088": 153         # 1080p（20s は非実用~40分→720p生成+外部upscale 推奨）
    "2560x1472": 81          # 1440p
  # V2V 継続（POST /generate/chain の source_video.context_frames）。/config で公開。
  # context_frames は 8n+1。max=145 は保守的な v1 上限（凍結ヘッドを stage-2 の
  # 1タイル内に収める。api.models.SourceVideoSpec 参照）。
  v2v_context_frames_default: 73
  v2v_context_frames_min: 25
  v2v_context_frames_max: 145
  # 素材（末尾）（POST /generate/chain の end_source.context_frames）。/config で公開。
  # 2 本以上は逆順Chained（reverse）＝帯は最終クリップ自身の末尾にあり、出力の尺は変わらない。
  # 旧方式（internal_segment）はAPIから到達不能。クリップ 1 本なら窓内モード（in_window）＝
  # 帯はクリップの内側にあり出力の尺は変わらない。既定の 72 は契約上の既定値であって推奨値では
  # ない——実機比較の結論は錨 8 フレームで、フロントエンドは常に 8 を明示送信する。
  # 正本は Docs/VERIFICATION_LOG.md §61・§63・§64 と api.models.EndSourceSpec。
  # 8 の倍数（8n+1 ではない。末尾帯は因果 VAE のキーフレーム潜在に触れず、末尾から
  # 8 個組で数えるため。chain_math.v_tail_latents 参照）。
  # 136 は自動決定される帯長の上限であって、幾何の上限ではない。136 = 17 潜在フレーム
  # ≒ 24fps で 5.67 秒。帯は最終クリップ自身の末尾にあり（窓内モード・逆順Chained）、stage-2 の
  # タイルを何枚またいでもよいため（凍結計画の正本は chain_math の end_tile_bands）、
  # 窓ごとの上限（旧 high_resolution = 88）は撤廃した。136 は未計測領域を避けるための
  # 運用上限で、どの stage-2 窓でも同じ値。引き上げるときは設定変更に加えて実機での
  # 品質確認が要る。既定 72 は契約上の既定値で、フロントエンドは常に 8 を送る。
  end_context_frames_default: 72
  end_context_frames_min: 8
  end_context_frames_max: 136
  # §1-17 Retake の窓長（POST /generate/chain の clips[0].num_frames）。/config で公開。
  # いずれも 8n+1。169 = stage-2 の 1 窓に収まる最大（standard 窓 v_tile=22）で、
  # high_resolution 窓（v_tile=19）では実上限が 145 へ下がる（サーバが 422 で拒否）。
  retake_window_min_frames: 73
  retake_window_max_frames: 169
  # 快適な stage-2 1 窓あたりの注意トークン上限。/config で公開し、クライアントが
  # 解像度スライダーの目安線を引くために使う。サーバはこの値で何も判定しない
  # （拒否も丸めもしない）純粋な助言値。トークン = (幅//32) × (高さ//32) × 窓の潜在フレーム数。
  # VRAM 容量に応じて上下してよい（小さい GPU なら下げ、大きい GPU なら上げる）。
  chain_comfort_token_budget: 40000
  # Create（単発 `/generate`）1 発が快適に収まる注意トークン上限。/config で公開。
  # chain_comfort_token_budget とは別軸（1 発は stage-2 タイル分割なしで全体を
  # 1 パスで精製するため、ワークロードが異なる）。サーバはこの値で何も判定しない
  # 純粋な助言値。式は同じ: トークン = (幅//32) × (高さ//32) × 潜在フレーム数。
  # WebUI の Create 画面は、5 つの高速化トグル（sage・block_swap_prefetch・
  # keep_resident・fused_gguf_dequant_kernel・vae_mode=prune_vaed）が全て on の
  # ときだけこの値から賢いマーカーを算出し、1 つでも off なら従来の
  # spill_free_frames へフォールバックする。44,880 は 2026-08-18 の4段階・21
  # ジョブ実機検証（3解像度×縦横）で較正された最大の共通快適値。正本は
  # Docs/COMFORT_LIMIT_TABLE.md。
  #
  # 注意: このコメントは example のみに書く。実運用 config.yaml には追記しない
  # ——chain_comfort_token_budget も実運用 yaml には無く Pydantic 既定値のまま
  # 配信されている前例に倣う（yaml に書くと将来の定数調整が実機に届かなくなる）。
  single_comfort_token_budget: 44880

output:
  dir: "./outputs"
  format: "mp4"
  save_metadata_json: true
  keep_raw_frames: false
